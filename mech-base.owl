    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0023043 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0023043">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000019"/>
