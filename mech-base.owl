                            </owl:Restriction>
                        </owl:intersectionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <owl:disjointWith rdf:resource="https://w3id.org/pmd/co/PMD_0020228"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000117>PERSON: Philipp von Hartrott</obo:IAO_0000117>
        <rdfs:label xml:lang="de">gelöste Rolle</rdfs:label>
        <rdfs:label xml:lang="en">solute role</rdfs:label>
        <skos:definition xml:lang="de">Rolle einer Entität, die in einer Lösung in geringer Konzentration vorhanden ist</skos:definition>
        <skos:definition xml:lang="en">role of an entity that is present in minor concentration in a solution</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0020228 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0020228">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020259"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000081"/>
