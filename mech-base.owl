        <obo:IAO_0000117>PERSON: Philipp von Hartrott</obo:IAO_0000117>
        <rdfs:label xml:lang="de">Anteil</rdfs:label>
        <rdfs:label xml:lang="en">proportion</rdfs:label>
        <skos:definition xml:lang="en">A proportion is a relational quality between two entities (the whole and the part) which quantifies the relation between the whole and its part.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0020102 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0020102">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0080069"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000116 xml:lang="en">Necessary and sufficient conditions for &apos;mass ratio&apos; have not yet been formalized. The term is defined as a specific subtype of &apos;material composition&apos;. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions.</obo:IAO_0000116>
        <obo:IAO_0000117>PERSON: Philipp von Hartrott</obo:IAO_0000117>
        <rdfs:label xml:lang="de">Massenverhältnis</rdfs:label>
        <rdfs:label xml:lang="en">mass ratio</rdfs:label>
        <skos:definition xml:lang="de">Das Massenverhältnis bezeichnet eine relationale Qualität, die einen Massenwert im Verhältnis zu einem anderen ausdrückt und typischerweise eine dimensionslose Zahl ergibt</skos:definition>
        <skos:definition xml:lang="en">Mass ratio denotes a relational quality expressing one mass value relative to another, typically producing a dimensionless number</skos:definition>
        <skos:example xml:lang="en">A fiber-reinforced composite has a fiber-to-matrix mass ratio of 60:40</skos:example>
        <co:PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</co:PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0020103 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0020103">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0080069"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000117>PERSON: Philipp von Hartrott</obo:IAO_0000117>
        <rdfs:label xml:lang="de">Molverhältnis</rdfs:label>
        <rdfs:label xml:lang="en">molar ratio</rdfs:label>
        <skos:altLabel xml:lang="en">molar proportion</skos:altLabel>
        <skos:definition xml:lang="de">Der Molanteil ist der Anteil, der die Anzahl der Einheiten des Teils im Verhältnis zur Anzahl der Einheiten des Ganzen quantifiziert.</skos:definition>
        <skos:definition xml:lang="en">Molar proportion is the proportion which quantifies the entities count of the part in relation to the entities count of the whole.</skos:definition>
        <skos:example xml:lang="en">The molar ratio of hydrogen gas H2 molecules to water H2O molecules is 1/1 in the oxyhydrogen reaction. The molar ratio of oxygen molecules O2 to water molecules is 2/1.
The molar ratio of carbon dioxide to average atmosphere air is 420 ppm as of 2022 AD.</skos:example>
        <co:PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</co:PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0020104 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0020104">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0080069"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000116 xml:lang="en">Necessary and sufficient conditions for &apos;volume ratio&apos; have not yet been formalized. The term is defined as a specific subtype of &apos;material composition&apos;. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions.</obo:IAO_0000116>
        <obo:IAO_0000117>PERSON: Philipp von Hartrott</obo:IAO_0000117>
        <rdfs:label xml:lang="de">Volumenverhältnis</rdfs:label>
        <rdfs:label xml:lang="en">volume ratio</rdfs:label>
        <skos:definition xml:lang="en">Volume ratio represents a relational quality expressing one volume value relative to another, typically resulting in a dimensionless number</skos:definition>
        <skos:definition xml:lang="de">Volumenverhältnis stellt eine relationale Qualität dar, die einen Volumenwert im Verhältnis zu einem anderen ausdrückt, typischerweise resultierend in einer dimensionslosen Zahl</skos:definition>
        <skos:example xml:lang="en">A foam material has a pore-to-solid volume ratio of 4:1, indicating 80 % porosity</skos:example>
        <co:PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</co:PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0020106 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0020106">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0000890"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/co/PMD_0000663"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000117>PERSON: Philipp von Hartrott</obo:IAO_0000117>
        <rdfs:label xml:lang="en">polycrystal</rdfs:label>
        <skos:altLabel xml:lang="en">Polycrystalline structure</skos:altLabel>
        <skos:definition xml:lang="en">A polycrystal is a connected material entity aggregate that consists of multiple crystal grains joined through crystallographic interfaces.</skos:definition>
        <co:PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</co:PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0020113 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0020113">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/BFO_0000030"/>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="https://w3id.org/pmd/co/PMD_0020289"/>
                            <rdf:Description rdf:about="https://w3id.org/pmd/co/PMD_0020290"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000030"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000117>PERSON: Philipp von Hartrott</obo:IAO_0000117>
        <rdfs:label xml:lang="en">fluid (object)</rdfs:label>
        <skos:definition xml:lang="en">Fluid (object) is an object that consists of some portion of matter which bears an aggregate state that concretizes a liquid or gaseous aggregate state.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0020114 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0020114">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020254"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000081"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/BFO_0000040"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000117>PERSON: Philipp von Hartrott</obo:IAO_0000117>
        <rdfs:label xml:lang="en">medium role</rdfs:label>
        <skos:definition xml:lang="en">Medium role is a role beared by an object which implies that the object serves as an intermediary for the transmission of something else, like energy, force, or information.</skos:definition>
        <skos:example xml:lang="en">Air in the air cooling process, N2 atmosphere in a furnace cooling process, oil in a quenching process, crystal lattice in a solid state diffusion</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0020128 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0020128">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/BFO_0000040"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000053"/>
                        <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/co/PMD_0020313"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000040"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000053"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/co/PMD_0020313"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">thermodynamic system</rdfs:label>
        <skos:definition xml:lang="en">A thermodynamic system is a material entity whose parts are bearer of thermodynamic properties. A thermodynamic system environs a thermodynamic process by which the thermodynamic properties of the objects of the thermodynamic system change over time.</skos:definition>
        <co:PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</co:PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0020132 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0020132">
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/BFO_0000019"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000080"/>
                        <owl:someValuesFrom>
                            <owl:Class>
                                <owl:unionOf rdf:parseType="Collection">
                                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/BFO_0000024"/>
                                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/BFO_0000027"/>
                                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/BFO_0000029"/>
                                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/BFO_0000030"/>
                                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/BFO_0000140"/>
                                </owl:unionOf>
                            </owl:Class>
                        </owl:someValuesFrom>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000117>PERSON: Philipp von Hartrott</obo:IAO_0000117>
        <rdfs:label xml:lang="en">spatial extend</rdfs:label>
        <skos:definition xml:lang="en">Dimension quality is a quality of a material entity that pertains to its measurable spatial extent, such as length, area, or volume</skos:definition>
        <skos:example xml:lang="en">the wall thickness of a steel pipe is a dimension quality functionally related to its pressure resistance</skos:example>
        <co:PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</co:PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0020133 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0020133">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0023000"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000080"/>
                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/BFO_0000024"/>
                            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/BFO_0000027"/>
                            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/BFO_0000030"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000117>PERSON: Philipp von Hartrott</obo:IAO_0000117>
        <rdfs:label xml:lang="de">Masse</rdfs:label>
        <rdfs:label xml:lang="en">mass</rdfs:label>
        <skos:definition xml:lang="en">Mass is fundamental extensive quality.</skos:definition>
        <co:PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</co:PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0020137 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0020137">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020000"/>
        <owl:disjointWith rdf:resource="https://w3id.org/pmd/co/PMD_0020149"/>
        <rdfs:comment xml:lang="en">See metastable phase</rdfs:comment>
        <rdfs:label xml:lang="en">stable phase</rdfs:label>
        <skos:definition xml:lang="en">A stable phase is a phase that does not have a &quot;pmd:disposition of a phase to transform&quot; in the &quot;pmd:phase transformation&quot; it participates.</skos:definition>
        <skos:example xml:lang="en">A phase that participates in a phase transformation pt and pt that is not a metastable phase.</skos:example>
        <co:PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</co:PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0020140 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0020140">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_60003"/>
        <rdfs:label xml:lang="en">portion of pure chemical element</rdfs:label>
        <skos:definition xml:lang="en">A portion of pure chemical element is a pure substance composed of multiple atoms, which are all of the same kind.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0020141 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0020141">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000015"/>
        <obo:IAO_0000117>PERSON: Philipp von Hartrott</obo:IAO_0000117>
        <rdfs:comment xml:lang="en">Fatigue is typically of interest when the change of the material affects the objects ability to fulfill its function.</rdfs:comment>
        <rdfs:label xml:lang="en">fatigue (reaction to repetitive loading)</rdfs:label>
        <skos:definition xml:lang="en">fatigue is a process that affects an material entities integrity by nucleation and growing cracks.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0020142 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0020142">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000019"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020353"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000080"/>
                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/BFO_0000024"/>
                            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/BFO_0000027"/>
                            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/BFO_0000030"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000117>PERSON: Philipp von Hartrott</obo:IAO_0000117>
        <obo:IAO_0000119 rdf:resource="http://openenergy-platform.org/ontology/oeo/OEO_00000150"/>
        <rdfs:label xml:lang="de">Energie</rdfs:label>
        <rdfs:label xml:lang="en">energy</rdfs:label>
        <skos:definition xml:lang="en">an extensive quality of material entities which manifests as a capacity to perform work (such as causing motion or the interaction of molecules)</skos:definition>
        <co:PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</co:PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0020143 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0020143">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000015"/>
        <rdfs:label xml:lang="en">process chain</rdfs:label>
        <skos:definition xml:lang="en">A process chain is a process that &apos;has continuant part&apos; subprocesses S1...Sn where S1...Sn precede each other and where some object or object aggregate that are output of Sn are then input to Sn+1.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0020149 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0020149">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020000"/>
        <rdfs:comment xml:lang="en">The stability of a phase can only be evaluated in the context of a (possibly unknown) phase transformation process.</rdfs:comment>
        <rdfs:label xml:lang="en">metastable phase</rdfs:label>
        <skos:definition xml:lang="en">A metastable phase phase_trans is a phase that has a &quot;pmd:disposition of a phase to transform&quot; disp_trans and disp_trans is realized in a &quot;pmd:phase transformation&quot; proc_trans and proc_trans has participant sys_trans and sys_trans has part phase_trans.</skos:definition>
        <co:PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</co:PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0020150 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0020150">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020132"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0023000"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000116 xml:lang="en">Necessary and sufficient conditions for &apos;volume&apos; have not yet been formalized. The term is defined as a specific subtype of &apos;DimensionQuality&apos;. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions. The definition is adapted from: http://purl.obolibrary.org/obo/PATO_0000918.</obo:IAO_0000116>
        <obo:IAO_0000117>PERSON: Philipp von Hartrott</obo:IAO_0000117>
        <rdfs:label xml:lang="de">Volumen</rdfs:label>
        <rdfs:label xml:lang="en">volume</rdfs:label>
        <skos:definition xml:lang="en">Volume is a three dimensional size.</skos:definition>
        <skos:definition xml:lang="de">Volumen ist eine dreidimensionale Größe.</skos:definition>
        <skos:example xml:lang="en">A cylindrical billet has a volume of 0.002 m3, determined from its radius and height</skos:example>
        <co:PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</co:PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0020151 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0020151">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020142"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0023000"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000117>PERSON: Philipp von Hartrott</obo:IAO_0000117>
        <rdfs:label xml:lang="de">innere Energie</rdfs:label>
        <rdfs:label xml:lang="en">internal energy</rdfs:label>
        <skos:definition xml:lang="de">Innere Energie ist eine universelle umfassende Qualität, die das Potenzial des Trägers zur Arbeit festlegt.</skos:definition>
        <skos:definition xml:lang="en">Internal energy is a universal extensive quality that specifies the bearers potential to do work.</skos:definition>
        <co:PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</co:PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0020161 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0020161">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000019"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020313"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0023004"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000080"/>
                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:intersectionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/CHEBI_60003"/>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000087"/>
                                <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/co/PMD_0020227"/>
                            </owl:Restriction>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002350"/>
                                <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/co/PMD_0020229"/>
                            </owl:Restriction>
                        </owl:intersectionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000117>PERSON: Philipp von Hartrott</obo:IAO_0000117>
        <obo:IAO_0000119>old defintion: 
Activity (a_X) is a relational property between a chemical species X and a non-ideal solution. a_X is a measure of the effective concentration of a chemical species X in the non-ideal solution, accounting for interactions between particles. It is defined as the product of the concentration and an activity coefficient, where the activity coefficient corrects for non-ideal behavior.</obo:IAO_0000119>
        <rdfs:label xml:lang="en">activity (thermodynamic)</rdfs:label>
        <rdfs:label xml:lang="de">thermodynamische Aktivität</rdfs:label>
        <skos:definition xml:lang="en">Thermodynamic activity is a relational quality that inheres between a chemical species and a non-ideal solution and represents the effective concentration of the species accounting for particle interactions.</skos:definition>
        <skos:definition xml:lang="de">Thermodynamische Aktivität ist eine Beziehungsqualität, die zwischen einer chemischen Spezies und einer nicht idealen Lösung innewohnt und die effektive Konzentration der Spezies darstellt, die für Partikelwechselwirkungen verantwortlich ist.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0020200 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0020200">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020311"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020317"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/pmd/co/PMD_0025999"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/BFO_0000030"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000117>PERSON: Philipp von Hartrott</obo:IAO_0000117>
        <obo:IAO_0000119>Old definition: Force is a reciprocal relation realized between two objects where the other object exerts the same force with opposite sign onto the first. Force may be responsible for changes in velocity and/or deformation of objects.</obo:IAO_0000119>
        <rdfs:label xml:lang="en">force</rdfs:label>
        <skos:definition xml:lang="en">A force is an entity that consists of a reciprocal interaction between two objects and is realized as equal and opposite influences capable of changing motion or causing deformation.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0020202 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0020202">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000029"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000117>PERSON: Philipp von Hartrott</obo:IAO_0000117>
        <rdfs:label xml:lang="de">Riss</rdfs:label>
        <rdfs:label xml:lang="en">crack</rdfs:label>
        <skos:definition xml:lang="en">A crack is a site that consists of a physical separation within a material entity occurring at the level of atomic bonds.</skos:definition>
        <skos:definition xml:lang="de">Ein Riss ist eine Stelle, die aus einer physikalischen Trennung innerhalb einer Materialeinheit besteht, die auf der Ebene atomarer Bindungen erfolgt.</skos:definition>
        <co:PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</co:PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0020203 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0020203">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000029"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000117>PERSON: Philipp von Hartrott</obo:IAO_0000117>
        <rdfs:label xml:lang="de">Kerbe</rdfs:label>
        <rdfs:label xml:lang="en">notch</rdfs:label>
        <skos:definition xml:lang="en">A notch is a site that consists of a geometric surface feature of an object characterized by a strong local change in shape or cross-section.</skos:definition>
        <skos:definition xml:lang="de">Eine Kerbe ist eine Stelle, die aus einem geometrischen Oberflächenmerkmal eines Objekts besteht, das durch eine starke lokale Änderung der Form oder des Querschnitts gekennzeichnet ist.</skos:definition>
        <co:PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</co:PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0020204 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0020204">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000029"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000117>PERSON: Philipp von Hartrott</obo:IAO_0000117>
        <rdfs:label xml:lang="de">Pore</rdfs:label>
        <rdfs:label xml:lang="en">pore</rdfs:label>
        <skos:definition xml:lang="en">A pore is a site that consists of a cavity located within the bulk of a material entity.</skos:definition>
        <skos:definition xml:lang="de">Eine Pore ist eine Stelle, die aus einem Hohlraum besteht, der sich innerhalb der Masse eines Materialgebildes befindet.</skos:definition>
        <co:PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</co:PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0020207 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0020207">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020103"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000117>PERSON: Philipp von Hartrott</obo:IAO_0000117>
        <rdfs:label xml:lang="de">Stoffmenge</rdfs:label>
        <rdfs:label xml:lang="en">amount of substance</rdfs:label>
        <skos:definition xml:lang="en">Amount of substance n is a molar proportion when the whole is an object aggregate N, which has avogadro number objects (of same type) as parts (n = N/N_A).</skos:definition>
        <skos:definition xml:lang="de">Die Menge der Substanz n ist ein molarer Anteil, wenn das Ganze ein Objektaggregat N ist, das Avogadro-Anzahlobjekte (gleicher Art) als Teile hat (n = N/N_A).</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0020210 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0020210">
        <owl:equivalentClass>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002351"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="https://w3id.org/pmd/co/PMD_0020140"/>
            </owl:Restriction>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020003"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002351"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/co/PMD_0020140"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">elemental crystal</rdfs:label>
        <skos:definition xml:lang="en">a crystal that consists of exactly one atomic species</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0020216 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0020216">
        <rdfs:comment>Use appropriate class from crystall ontology instead</rdfs:comment>
        <rdfs:label xml:lang="en">DEPRECATED order scale value</rdfs:label>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
        <skos:definition xml:lang="de">DEPRECATED Mögliche Werte der charakteristischen Länge, über die strukturelle Zusammenhänge in einem Material bestehen bleiben</skos:definition>
        <skos:definition xml:lang="en">DEPRECATED possible values of characteristic length over which structural correlations persist in a material</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0020227 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0020227">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020259"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000081"/>
                <owl:someValuesFrom>
