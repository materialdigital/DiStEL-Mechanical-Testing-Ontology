    <!-- https://w3id.org/pmd/mech/MECH_0000103 -->

    <owl:Class rdf:about="https://w3id.org/pmd/mech/MECH_0000103">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0000001"/>
        <rdfs:label xml:lang="en">air</rdfs:label>
        <skos:definition xml:lang="en">air is a portion of matter which corresponds to the molecular composition of air.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/mech/MECH_0002001 -->

    <owl:Class rdf:about="https://w3id.org/pmd/mech/MECH_0002001">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/mech/MECH_0000032"/>
        <rdfs:label xml:lang="en">fatigue alternating strength</rdfs:label>
        <skos:definition xml:lang="en">Fatigue alternating strength is an endurance limit which desribes the maximum cyclic stress amplitude that a material must withstand without failure assuming an infinite number of load cycles under load ratio of -1.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/mech/MECH_0002002 -->

    <owl:Class rdf:about="https://w3id.org/pmd/mech/MECH_0002002">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/mech/MECH_0000068"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/tto/TTO_0000038"/>
        <rdfs:label xml:lang="en">percentage reduction of area at fracture</rdfs:label>
        <skos:definition xml:lang="en">change in cross-sectional area of a specimen after fracture (S_o − S_f), expressed as a percentage of the original cross-sectional area, S_o</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/mech/MECH_0002003 -->

    <owl:Class rdf:about="https://w3id.org/pmd/mech/MECH_0002003">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0000583"/>
        <rdfs:label xml:lang="en">fatigue test evaluation process</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/mech/MECH_0002004 -->

    <owl:Class rdf:about="https://w3id.org/pmd/mech/MECH_0002004">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/mech/MECH_0002003"/>
        <rdfs:label xml:lang="en">S-N curve parameter estimation process</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/mech/MECH_0002005 -->

    <owl:Class rdf:about="https://w3id.org/pmd/mech/MECH_0002005">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/mech/MECH_0002004"/>
        <rdfs:label xml:lang="en">S-N curve parameter estimation removing UHCF data</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/mech/MECH_0002006 -->

    <owl:Class rdf:about="https://w3id.org/pmd/mech/MECH_0002006">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000010"/>
        <rdfs:label xml:lang="en">Jurojin software</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/mech/MECH_0002007 -->

    <owl:Class rdf:about="https://w3id.org/pmd/mech/MECH_0002007">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0000551"/>
        <rdfs:label xml:lang="en">carbon equivalent value</rdfs:label>
        <skos:altLabel xml:lang="en">CEV</skos:altLabel>
        <skos:definition xml:lang="en">Carbon equivalent value is a single number that qualifies the chemical composition of a steel by turning the effects of all alloying elements into an equivalent percentage of carbon to measure how easily steel can be welded</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/mech/MECH_0002008 -->

    <owl:Class rdf:about="https://w3id.org/pmd/mech/MECH_0002008">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020317"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020353"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/pmd/co/PMD_0025999"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/BFO_0000030"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <qudt:symbol xml:lang="en">K_t</qudt:symbol>
        <rdfs:label xml:lang="en">stress concentration factor</rdfs:label>
        <skos:definition xml:lang="en">A stress concentration factor (\(K_{t}\)) is a relational quality of an object that defines how much higher the peak local stress is compared to the nominal reference stress near a geometric discontinuity</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/mech/MECH_0002009 -->

    <owl:Class rdf:about="https://w3id.org/pmd/mech/MECH_0002009">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020308"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020353"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000052"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/co/PMD_0000965"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <qudt:symbol xml:lang="en">Rz</qudt:symbol>
        <rdfs:label xml:lang="en">Rz</rdfs:label>
        <skos:definition xml:lang="en">Rz is a surface property of an object which is the average maximum height of a surface profile, calculated by measuring the vertical distance from the highest peak to the lowest valley within individual sampling lengths and averaging them</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/mech/MECH_0002010 -->

    <owl:Class rdf:about="https://w3id.org/pmd/mech/MECH_0002010">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020308"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000052"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/co/PMD_0000965"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <owl:disjointWith rdf:resource="https://w3id.org/pmd/mech/MECH_0002011"/>
        <rdfs:label xml:lang="en">surface hardness</rdfs:label>
        <skos:definition xml:lang="en">The surface hardness is a hardness measured on the surface of an object</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/mech/MECH_0002011 -->

    <owl:Class rdf:about="https://w3id.org/pmd/mech/MECH_0002011">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020307"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000052"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/co/PMD_0000538"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">core hardness</rdfs:label>
        <skos:definition xml:lang="en">The core hardness is a hardness measured on the bulk or core of an object</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/mech/MECH_0002012 -->

    <owl:Class rdf:about="https://w3id.org/pmd/mech/MECH_0002012">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0025012"/>
        <rdfs:label xml:lang="en">vickers hardness to tensile strength conversion</rdfs:label>
        <skos:definition xml:lang="en">An analytical calculation that computes tensile strength from vickers hardness value.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/mech/MECH_0002013 -->

    <owl:Class rdf:about="https://w3id.org/pmd/mech/MECH_0002013">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0025012"/>
        <rdfs:label xml:lang="en">rockwell hardness to tensile strength conversion</rdfs:label>
        <skos:definition xml:lang="en">An analytical calculation that computes tensile strength from rockwell hardness value.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/mech/MECH_0002014 -->

    <owl:Class rdf:about="https://w3id.org/pmd/mech/MECH_0002014">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0025012"/>
        <rdfs:label xml:lang="en">tensile strength to vickers hardness conversion</rdfs:label>
        <skos:definition xml:lang="en">An analytical calculation that computes vickers hardness from tensile strength value.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/mech/MECH_0002015 -->

    <owl:Class rdf:about="https://w3id.org/pmd/mech/MECH_0002015">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0025012"/>
        <rdfs:label xml:lang="en">brinell hardness to vickers hardness conversion</rdfs:label>
        <skos:definition xml:lang="en">An analytical calculation that computes vickers hardness from brinell hardness value.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/mech/MECH_0002016 -->

    <owl:Class rdf:about="https://w3id.org/pmd/mech/MECH_0002016">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0025012"/>
        <rdfs:label xml:lang="en">rockwell hardness to vickers hardness conversion</rdfs:label>
        <skos:definition xml:lang="en">An analytical calculation that computes vickers hardness from rockwell hardness value.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/mech/MECH_0002017 -->

    <owl:Class rdf:about="https://w3id.org/pmd/mech/MECH_0002017">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000023"/>
        <rdfs:label xml:lang="en">mechanical testing specimen role</rdfs:label>
    </owl:Class>
    


