                            </owl:Restriction>
                        </owl:intersectionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000117>PERSON: Philipp von Hartrott</obo:IAO_0000117>
        <rdfs:label xml:lang="de">Lösungsmittelrolle</rdfs:label>
        <rdfs:label xml:lang="en">solvent role</rdfs:label>
        <skos:definition xml:lang="de">Rolle einer Entität, die in einer Lösung in großer Konzentration vorhanden ist</skos:definition>
        <skos:definition xml:lang="en">role of an entity that is present in major concentration in a solution</skos:definition>
    </owl:Class>
    


