    <!-- https://w3id.org/pmd/hto/HTO_0000019 -->

    <owl:Class rdf:about="https://w3id.org/pmd/hto/HTO_0000019">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/hto/HTO_0000040"/>
        <dcterms:source>DIN 17022-5:2000, §1</dcterms:source>
        <dcterms:source>DIN 17022-5:2000, §4</dcterms:source>
        <dcterms:source>DIN EN ISO 4885:2018, §3.200</dcterms:source>
        <rdfs:label xml:lang="de">Oberflächenhärtung</rdfs:label>
        <rdfs:label xml:lang="en">surface hardening</rdfs:label>
        <skos:altLabel xml:lang="de">Oberflächenhärtung</skos:altLabel>
        <skos:altLabel xml:lang="de">Randschichthärtung</skos:altLabel>
        <skos:definition xml:lang="de">Auf die Randschicht beschränkte Härtung (3.167).</skos:definition>
        <skos:definition xml:lang="en">Hardening (3.167) restricted to the surface layer.</skos:definition>
        <skos:definition>Hardening process where only the surface of a part and not its entire volume is hardened.</skos:definition>
        <skos:editorialNote xml:lang="en">DIN audit fix (2026-06-09): DIN EN ISO 4885 §3.200 lemma is &apos;Randschichthärten&apos;; DIN 17022-5 uses &apos;Randschichthärten&apos; exclusively in its title. The hto-edit.owl DE label &apos;Oberflächenhärtung&apos; is a DIN-10052 / legacy synonym (already retained in hto-edit.owl as skos:altLabel — preserved here). The DIN-canonical &apos;Randschichthärten&apos; is hoisted to skos:prefLabel.</skos:editorialNote>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/hto/HTO_0000032 -->

    <owl:Class rdf:about="https://w3id.org/pmd/hto/HTO_0000032">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0060009"/>
        <dcterms:creator>thonagel</dcterms:creator>
        <dcterms:source>DIN 17022-1:1994, §5 (Sollwert / Solltemperatur, procedural usage)</dcterms:source>
        <rdfs:comment>Internally (within the devices&apos; logic) a process is run to reach and maintain the given setpoint.</rdfs:comment>
        <rdfs:label xml:lang="de">Sollwert</rdfs:label>
        <rdfs:label xml:lang="en">setpoint</rdfs:label>
        <skos:definition xml:lang="en">A Set Point is a specification datum that assigns a desired quantitative value to a controlled process parameter, serving as the normative reference for process execution and control.</skos:definition>
        <skos:definition xml:lang="de">Ein Sollwert ist ein Spezifikationswert, der einem geregelten Prozessparameter einen gewünschten quantitativen Wert zuweist und als normgebende Referenz für die Prozessausführung und -steuerung dient.</skos:definition>
        <skos:editorialNote xml:lang="en">DIN audit (2026-06-09): DIN EN ISO 4885 does not enumerate &apos;Sollwert&apos; as a §3 lemma; PMDco owns the generic &apos;setpoint&apos; concept upstream. The DIN procedural anchor is DIN 17022-1 §5 (Sollwert / Solltemperatur operational usage). Provenance is therefore procedural rather than terminological.</skos:editorialNote>
        <skos:example>The flow rate for a mass flow controller.
The target temperature in the furnace chamber for a given process step.
The rotational speed of a fan.</skos:example>
        <co:PMD_0000064>tdb</co:PMD_0000064>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/hto/HTO_0000040 -->

    <owl:Class rdf:about="https://w3id.org/pmd/hto/HTO_0000040">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0000103"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0000779"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000059"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/hto/HTO_0000013"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <dcterms:source>DIN 17022-1:1994, §3.1</dcterms:source>
        <dcterms:source>DIN EN ISO 4885:2018, §3.167</dcterms:source>
        <rdfs:label xml:lang="de">Härtung durch Wärmebehandlung</rdfs:label>
        <rdfs:label xml:lang="en">hardening heat treatment</rdfs:label>
        <skos:definition xml:lang="en">Heat treatment process to increase the strength and hardness of the material by cooling it so that its microstructure transforms to the hardening structure.</skos:definition>
        <skos:definition xml:lang="de">Prozess zur Härtung eines zuvor austenitisierten (3.14) Werkstückes, durch Abkühlen (3.45) unter Bedingungen erreicht, die geeignet sind, den Austenit (3.12) nahezu vollständig in Martensit (3.137) und gegebenenfalls Bainit (3.17) umzuwandeln.</skos:definition>
        <skos:definition xml:lang="de">Wärmebehandlungprozess durch den eine Härte- und Festigkeitssteigerung erreicht wird, in dem das Material mit solcher Geschwindikeit abgekühlt wird, dass ein Härtungsgefüge enstehen kann.</skos:definition>
        <skos:example xml:lang="de">Randschichthärten

Einsatzhärten
Nitrierhärten</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/hto/HTO_0000072 -->

    <owl:Class rdf:about="https://w3id.org/pmd/hto/HTO_0000072">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/hto/HTO_0000019"/>
        <obo:IAO_0000116 xml:lang="en">this is really not connected to the phenomenon of case hardening found in mangos</obo:IAO_0000116>
        <dcterms:source>DIN EN ISO 4885:2018, §3.37 (Einsatzhärten = Aufkohlen + Härten)</dcterms:source>
        <rdfs:label xml:lang="de">Einsatzhärten</rdfs:label>
        <rdfs:label xml:lang="en">case hardening</rdfs:label>
        <skos:definition xml:lang="de">Behandlung bestehend aus Aufkohlen (3.36) oder Carbonitrieren (3.35) mit anschließender Härtung (3.167).</skos:definition>
        <skos:definition xml:lang="en">Surface hardening process comprised of carburising, hardening and tempering of case hardnening steels.</skos:definition>
        <skos:definition xml:lang="en">Treatment consisting of carburising (3.36) or carbonitriding (3.35) followed by hardening (3.167).</skos:definition>
        <skos:editorialNote xml:lang="en">DIN audit (2026-06-09, γ refinement): HTO_0000072 (recently added upstream as case-hardening PROCESS) is overlaid here with DE label &apos;Einsatzhärten&apos; and verbatim 4885 §3.37 wording. Earlier draft had a twin class hto:HTO_0000106; removed in favour of this overlay to keep upstream IRIs intact (Q2c style). HTO_0000106 slot vacated for Divya to re-claim. The depth measure CHD is the separate HTO_0000089 — do not conflate process with depth.</skos:editorialNote>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/mech/MECH_0000000 -->

    <owl:Class rdf:about="https://w3id.org/pmd/mech/MECH_0000000">
        <owl:equivalentClass>
            <owl:Class>
                <owl:oneOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/pmd/mech/MECH_0000001"/>
                    <rdf:Description rdf:about="https://w3id.org/pmd/mech/MECH_0000002"/>
                    <rdf:Description rdf:about="https://w3id.org/pmd/mech/MECH_0000003"/>
                    <rdf:Description rdf:about="https://w3id.org/pmd/mech/MECH_0000004"/>
                    <rdf:Description rdf:about="https://w3id.org/pmd/mech/MECH_0000005"/>
                    <rdf:Description rdf:about="https://w3id.org/pmd/mech/MECH_0000006"/>
                    <rdf:Description rdf:about="https://w3id.org/pmd/mech/MECH_0000007"/>
                    <rdf:Description rdf:about="https://w3id.org/pmd/mech/MECH_0002000"/>
                </owl:oneOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OBI_0001930"/>
        <rdfs:label xml:lang="en">fatigue loading type value</rdfs:label>
        <skos:definition xml:lang="en">Fatigue loading type values is a categotical value specification which describes the direction of an applied force in respect to the specimen during fatigue testing.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/mech/MECH_0000008 -->

    <owl:Class rdf:about="https://w3id.org/pmd/mech/MECH_0000008">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0000008"/>
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://w3id.org/pmd/co/PMD_0000077"/>
                        <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/mech/MECH_0000000"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://w3id.org/pmd/co/PMD_0000077"/>
                        <owl:allValuesFrom rdf:resource="https://w3id.org/pmd/mech/MECH_0000000"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/pmd/co/PMD_0025006"/>
                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="https://w3id.org/pmd/co/PMD_0000638"/>
                            <rdf:Description rdf:about="https://w3id.org/pmd/co/PMD_0025020"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">Note: some of the loading type can be performed only with a specific control type. It will be proved using SWRL rules.</rdfs:comment>
        <rdfs:label xml:lang="en">fatigue loading type</rdfs:label>
        <skos:definition xml:lang="en">Fatigue loading type is process attribute which describes the direction of an applied force in respect to the specimen during fatigue testing.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/mech/MECH_0000009 -->

    <owl:Class rdf:about="https://w3id.org/pmd/mech/MECH_0000009">
        <owl:equivalentClass>
            <owl:Class>
                <owl:oneOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/pmd/mech/MECH_0000011"/>
                    <rdf:Description rdf:about="https://w3id.org/pmd/mech/MECH_0000012"/>
                </owl:oneOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OBI_0001930"/>
        <rdfs:label xml:lang="en">control type value</rdfs:label>
        <skos:definition xml:lang="en">Control type value is a categorical value specification which describes the variable (stress or strain) that remains constant during mechanical testing testing.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/mech/MECH_0000010 -->

    <owl:Class rdf:about="https://w3id.org/pmd/mech/MECH_0000010">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0000008"/>
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://w3id.org/pmd/co/PMD_0000077"/>
                        <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/mech/MECH_0000009"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://w3id.org/pmd/co/PMD_0000077"/>
                        <owl:allValuesFrom rdf:resource="https://w3id.org/pmd/mech/MECH_0000009"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/pmd/co/PMD_0025006"/>
                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="https://w3id.org/pmd/co/PMD_0000638"/>
                            <rdf:Description rdf:about="https://w3id.org/pmd/co/PMD_0025020"/>
                            <rdf:Description rdf:about="https://w3id.org/pmd/mech/MECH_0025001"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">control type of a mechanical test</rdfs:label>
        <skos:definition xml:lang="en">control type of a mechanical test is a process attribute of a fatigue testing or hot tensile testing which describes the variable (stress or strain) that remains constant during the  testing.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/mech/MECH_0000013 -->

    <owl:Class rdf:about="https://w3id.org/pmd/mech/MECH_0000013">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0000008"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/pmd/co/PMD_0025006"/>
                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="https://w3id.org/pmd/co/PMD_0000638"/>
                            <rdf:Description rdf:about="https://w3id.org/pmd/co/PMD_0025020"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">fatigue waveform</rdfs:label>
        <skos:definition xml:lang="en">Fatigue waveform is a process attribute of a fatigue testing which describes the shape of a mechanical acuation signal (load).</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/mech/MECH_0000014 -->

    <owl:Class rdf:about="https://w3id.org/pmd/mech/MECH_0000014">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0025007"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/pmd/co/PMD_0025006"/>
                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="https://w3id.org/pmd/co/PMD_0000638"/>
                            <rdf:Description rdf:about="https://w3id.org/pmd/co/PMD_0025020"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">fatigue testing frequency</rdfs:label>
        <skos:definition xml:lang="en">Fatigue testing frequency is a process attribute of a fatigue testing which indicates how many loading cycles the sample experiences within a second.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/mech/MECH_0000017 -->

    <owl:Class rdf:about="https://w3id.org/pmd/mech/MECH_0000017">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0000952"/>
        <rdfs:label xml:lang="en">fatigue strength</rdfs:label>
        <skos:definition xml:lang="en">Fatigue strength is a strength which is realized in the fatigue process and desribes the maximum cyclic stress amplitude that a material can withstand without failure.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/mech/MECH_0000018 -->

    <owl:Class rdf:about="https://w3id.org/pmd/mech/MECH_0000018">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0000008"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/pmd/co/PMD_0025006"/>
                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="https://w3id.org/pmd/co/PMD_0000638"/>
                            <rdf:Description rdf:about="https://w3id.org/pmd/co/PMD_0025020"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">loading amplitude</rdfs:label>
        <skos:definition xml:lang="en">Loading amplitude is a maximal difference between a minimal and maximal stress or strain (depending on the fatigue control type) that the specimen experiences during a fatigue testing.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/mech/MECH_0000019 -->

    <owl:Class rdf:about="https://w3id.org/pmd/mech/MECH_0000019">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0000008"/>
        <rdfs:label xml:lang="en">fatigue mean stress</rdfs:label>
        <skos:definition xml:lang="en">Fatigue mean stress is a average value of a stress that the specimen experiences during fatigue testing.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/mech/MECH_0000020 -->

    <owl:Class rdf:about="https://w3id.org/pmd/mech/MECH_0000020">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0000008"/>
        <rdfs:comment>TODO write axioms for the specific loading ratios</rdfs:comment>
        <rdfs:label xml:lang="en">loading ratio</rdfs:label>
        <skos:definition xml:lang="en">Loading ratio is a process attribute of a fatigue testing which describes the ratio between the minimal and the maximal value of some physical quality, namely stress, strain, or load.</skos:definition>
        <co:symbol>R</co:symbol>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/mech/MECH_0000021 -->

    <owl:Class rdf:about="https://w3id.org/pmd/mech/MECH_0000021">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/mech/MECH_0000020"/>
        <rdfs:label xml:lang="en">stress ratio</rdfs:label>
        <skos:definition xml:lang="en">Stress ratio is a loading ratio process attribute of a fatigue test which is determined as a ratio between the maximum and minimum value of a stress applied to the specimen.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/mech/MECH_0000022 -->

    <owl:Class rdf:about="https://w3id.org/pmd/mech/MECH_0000022">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/mech/MECH_0000020"/>
        <rdfs:label xml:lang="en">strain ratio</rdfs:label>
        <skos:definition xml:lang="en">Strain ratio is a loading ratio process attribute of a fatigue test which is determined as a ratio between the maximum and minimum value of a strain which the specimen experiences.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/mech/MECH_0000023 -->

    <owl:Class rdf:about="https://w3id.org/pmd/mech/MECH_0000023">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/mech/MECH_0000020"/>
        <rdfs:label xml:lang="en">load ratio</rdfs:label>
        <skos:altLabel xml:lang="en">force ratio</skos:altLabel>
        <skos:definition xml:lang="en">Load ratio is a loading ratio process attribute of a fatigue test which is determined as a ratio between the maximum and minimum value of an applied load (force).</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/mech/MECH_0000024 -->

    <owl:Class rdf:about="https://w3id.org/pmd/mech/MECH_0000024">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/mech/MECH_0000018"/>
        <rdfs:label xml:lang="en">stress amplitude</rdfs:label>
        <skos:definition xml:lang="en">Stress amplitude is a maximal difference between a minimal and maximal stress that the specimen experiences during a fatigue testing.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/mech/MECH_0000025 -->

    <owl:Class rdf:about="https://w3id.org/pmd/mech/MECH_0000025">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/mech/MECH_0000018"/>
        <rdfs:label xml:lang="en">strain amplitude</rdfs:label>
        <skos:definition xml:lang="en">Strain amplitude is a maximal difference between a minimal and maximal strain that the specimen experiences during a fatigue testing.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/mech/MECH_0000026 -->

    <owl:Class rdf:about="https://w3id.org/pmd/mech/MECH_0000026">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0000008"/>
        <rdfs:label xml:lang="en">fatigue maximum stress</rdfs:label>
        <skos:definition xml:lang="en">Fatigue maximum stress is a process attribute of a fatigue testing process which describes the maximum stress that the specimen experiences. Its value corresponds to the max peak of a fatigue waveform.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/mech/MECH_0000027 -->

    <owl:Class rdf:about="https://w3id.org/pmd/mech/MECH_0000027">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0000008"/>
        <rdfs:label xml:lang="en">fatigue minimum stress</rdfs:label>
        <skos:definition xml:lang="en">Fatigue minimum stress is a process attribute of a fatigue testing process which describes the minimum stress that the specimen experiences. Its value corresponds to the min peak of a fatigue waveform.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/mech/MECH_0000028 -->

    <owl:Class rdf:about="https://w3id.org/pmd/mech/MECH_0000028">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OBI_0001930"/>
        <rdfs:comment>TODO add other individuals</rdfs:comment>
        <rdfs:label xml:lang="en">loading ratio type value</rdfs:label>
        <skos:definition xml:lang="en">Loading ratio type value is a categorical value specification which specifies value of a loading ratio process attribute and qualitatively describes the ratio between the minumum and maximum loading (force, stress, strain) of a specimen during a fatigue testing. It is equivalent to the scalar value specification of R.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/mech/MECH_0000030 -->

    <owl:Class rdf:about="https://w3id.org/pmd/mech/MECH_0000030">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0000008"/>
        <rdfs:label xml:lang="en">fatigue cycle limit</rdfs:label>
        <skos:definition xml:lang="en">Fatigue cycle limit is a process attribute of a fatigue testing process which describes the maximum number of loading cycles that would be performed if the specimen does not fail (break) before undergoing this number of cycles.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/mech/MECH_0000031 -->

    <owl:Class rdf:about="https://w3id.org/pmd/mech/MECH_0000031">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/mech/MECH_0000017"/>
        <rdfs:label xml:lang="en">fatigue strength at cycle limit</rdfs:label>
        <skos:definition xml:lang="en">Fatigue strength at cycle limit is a fatigue strength which desribes the maximum cyclic stress amplitude that a material must withstand without failure for a predetermined number of cycles.</skos:definition>
        <skos:example xml:lang="en">if a material has a fatigue strength of 200 MPa at 10^6 cycles, this means that when subjected to a cyclic stress of 200 MPa, the material is expected to fail after approximately 10^6 cycles.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/mech/MECH_0000032 -->

    <owl:Class rdf:about="https://w3id.org/pmd/mech/MECH_0000032">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/mech/MECH_0000017"/>
        <rdfs:comment xml:lang="en">This limit is characteristic of certain ferrous (iron-based) and titanium alloys, for which the S-N curve and underlying data points level off at high cycle counts, indicating that failure is unlikely to occur below the limit. In contrast, materials like aluminium and copper typically do not exhibit a distinct endurance limit.</rdfs:comment>
        <rdfs:label xml:lang="en">fatigue endurance limit</rdfs:label>
        <skos:definition xml:lang="en">Fatigue endurance limit is a fatigue strength which desribes the maximum cyclic stress amplitude that a material must withstand without failure assuming an infinite number of load cycles.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/mech/MECH_0000033 -->

    <owl:Class rdf:about="https://w3id.org/pmd/mech/MECH_0000033">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0000848"/>
        <rdfs:label xml:lang="en">knee point</rdfs:label>
        <skos:definition xml:lang="en">Knee point is a mechnical property realized in a fatigue process which describes the number of cycles at which the slope of a fatigue curve changes.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/mech/MECH_0000034 -->

    <owl:Class rdf:about="https://w3id.org/pmd/mech/MECH_0000034">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0000848"/>
        <rdfs:label xml:lang="en">slope of S-N curve</rdfs:label>
        <skos:definition xml:lang="en">Slope of S-N curve is a mechanical property realized in the fatigue testing which defines the inclination of the S-N curve in the finite life fatigue region.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/mech/MECH_0000035 -->

    <owl:Class rdf:about="https://w3id.org/pmd/mech/MECH_0000035">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0000008"/>
        <rdfs:comment xml:lang="en">For now a free text description, i.e., pointing to a value specification</rdfs:comment>
        <rdfs:label xml:lang="en">failure criterion</rdfs:label>
        <skos:definition xml:lang="en">Failure criterion is a process attribute which describes the conditions at which a fatigue specimen is considered to be failed, i.e., no further cycles are applied.</skos:definition>
        <skos:example xml:lang="en">A crack in a specimen, which exceeds certain length. A significant drop in a load which material experiences.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/mech/MECH_0000036 -->

    <owl:Class rdf:about="https://w3id.org/pmd/mech/MECH_0000036">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0000637"/>
        <rdfs:label xml:lang="en">tensile fatigue testing machine</rdfs:label>
        <skos:definition xml:lang="en">Tensile fatigue testing machine is a type of a fatigue testing machine which are designed to evaluate the mechanical fatigue of materials by applying repeated cyclic tension or compression loads. Such machines are primarly designed for uniaxial tension-tension or tension-compression fatigue.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/mech/MECH_0000037 -->

    <owl:Class rdf:about="https://w3id.org/pmd/mech/MECH_0000037">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0000637"/>
        <obo:IAO_0000119>https://www.sciencedirect.com/science/article/pii/S0142112325002257</obo:IAO_0000119>
        <rdfs:label xml:lang="en">ultrasonic fatigue testing machine</rdfs:label>
        <skos:definition xml:lang="en">Ultrasonic fatigue testing machine is a type of a fatigue testing machine which applies load at a frequency equal to the specimen’s natural frequency.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/mech/MECH_0000038 -->

    <owl:Class rdf:about="https://w3id.org/pmd/mech/MECH_0000038">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/mech/MECH_0000045"/>
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/OBI_0000312"/>
                        <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/co/PMD_0000638"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/OBI_0000312"/>
                        <owl:allValuesFrom rdf:resource="https://w3id.org/pmd/co/PMD_0000638"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">S-N curve</rdfs:label>
        <skos:definition xml:lang="en">An S-N curve is a 2D data item, which is a specified output of a fatigue testing and describes an ability of a material to resist fracture under repeated, alternating loads over a finite or infinite duration.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/mech/MECH_0000039 -->

    <owl:Class rdf:about="https://w3id.org/pmd/mech/MECH_0000039">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000009"/>
        <rdfs:label xml:lang="en">axis label of fatigue curve</rdfs:label>
        <skos:definition xml:lang="en">Axis label of S-N curve is a datum label which desribes the label of the axis (x- or y-) in the S-N curve.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/mech/MECH_0000040 -->

    <owl:Class rdf:about="https://w3id.org/pmd/mech/MECH_0000040">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/mech/MECH_0000039"/>
        <rdfs:label xml:lang="en">y-axis label of fatigue curve</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/mech/MECH_0000041 -->

    <owl:Class rdf:about="https://w3id.org/pmd/mech/MECH_0000041">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/mech/MECH_0000039"/>
        <rdfs:label xml:lang="en">x-axis label of fatigue curve</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/mech/MECH_0000042 -->

    <owl:Class rdf:about="https://w3id.org/pmd/mech/MECH_0000042">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/mech/MECH_0000038"/>
        <rdfs:label xml:lang="en">semi-log S-N curve</rdfs:label>
        <skos:definition xml:lang="en">Semi-log S-N curve is a type of S-N curve, where both x-axis (the time variable) is given in logarithmic scale, while y-axis (loading variable) is given in its original scale.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/mech/MECH_0000043 -->

    <owl:Class rdf:about="https://w3id.org/pmd/mech/MECH_0000043">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/mech/MECH_0000038"/>
        <rdfs:label xml:lang="en">log-log S-N curve</rdfs:label>
        <skos:definition xml:lang="en">Log-log S-N curve is a type of S-N curve, where both x-axis (the time variable) and y-axis (loading variable) are given in the logarithm scale.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/mech/MECH_0000044 -->

    <owl:Class rdf:about="https://w3id.org/pmd/mech/MECH_0000044">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/mech/MECH_0000038"/>
        <rdfs:label xml:lang="en">linear S-N curve</rdfs:label>
        <skos:definition xml:lang="en">Linear S-N curve is a type of S-N curve, where both x-axis (the time variable) and y-axis (loading variable) are given in its original scaling.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/mech/MECH_0000045 -->

    <owl:Class rdf:about="https://w3id.org/pmd/mech/MECH_0000045">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0000502"/>
        <rdfs:label xml:lang="en">fatigue life curve</rdfs:label>
        <skos:definition xml:lang="en">Fatigue life curve is a 2D data item which is an output from a fatigue testing process, and it is about the performance of a material under cyclic load.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/mech/MECH_0000046 -->

    <owl:Class rdf:about="https://w3id.org/pmd/mech/MECH_0000046">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/mech/MECH_0000045"/>
        <rdfs:label xml:lang="en">ε-N curve</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/mech/MECH_0000047 -->

    <owl:Class rdf:about="https://w3id.org/pmd/mech/MECH_0000047">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0000638"/>
        <obo:IAO_0000119>https://en.wikipedia.org/wiki/Rolling_contact_fatigue</obo:IAO_0000119>
        <rdfs:label xml:lang="en">rolling contact fatigue testing process</rdfs:label>
        <skos:altLabel xml:lang="en">RCF</skos:altLabel>
        <skos:definition xml:lang="en">Rolling contact fatigue (RCF) testing is a fatigue testing process that evaluates material performance under repeated loading while applying high cyclic contact pressure and sliding until failure (pitting/spalling) occurs.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/mech/MECH_0000048 -->

    <owl:Class rdf:about="https://w3id.org/pmd/mech/MECH_0000048">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0000638"/>
        <obo:IAO_0000119 xml:lang="en">Tensile fatigue testing process is a fatigue testing process  that evaluates material performance under repeated loading while applying cyclic, axial tensile stress. The test can involve constant amplitude or variable amplitude loading.</obo:IAO_0000119>
        <rdfs:label xml:lang="en">tensile fatigue testing process</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/mech/MECH_0000049 -->

    <owl:Class rdf:about="https://w3id.org/pmd/mech/MECH_0000049">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0000005"/>
        <rdfs:label xml:lang="en">number of sustained loading cycles</rdfs:label>
        <skos:altLabel xml:lang="en">fatigue lifetime</skos:altLabel>
        <skos:definition xml:lang="en">Number of sustained loading cycles is a behavioral characteristic of a material in a single fatigue testing process, and it describes how many cycles of applied load the material can sustain before failure.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/mech/MECH_0000050 -->

    <owl:Class rdf:about="https://w3id.org/pmd/mech/MECH_0000050">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0025020"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/OBI_0000299"/>
                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:intersectionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/BFO_0000030"/>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000087"/>
                                <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/mech/MECH_0002018"/>
                            </owl:Restriction>
                        </owl:intersectionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <owl:disjointWith rdf:resource="https://w3id.org/pmd/mech/MECH_0000052"/>
        <rdfs:comment xml:lang="en">The axioms about NOT having a failure: 
Option 1 (easy): SHACL Shape specifically for this class, stating that it cannot have fatigue specimen failure as occurent part.
Option 2 (ontology advanced): make an equv. class axiom with some and only to make a an exaustive and close list of triples the class is allowed to have. Then, if the failure is an occurent part, it will be automatically inferred as &quot;.. test with failed specimen&quot;. If no failure is explicitly given, but all the other essential triples are asserted, it will be classified as &quot;.. test with run out&quot;</rdfs:comment>
        <rdfs:label xml:lang="en">single fatigue testing process with run out</rdfs:label>
        <skos:definition xml:lang="en">Single fatigue testing process with run out is a single fatigue testing process in which the specimen did not fail when the fatigue cycle limit is reached.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/mech/MECH_0000051 -->

    <owl:Class rdf:about="https://w3id.org/pmd/mech/MECH_0000051">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020258"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000132"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/co/PMD_0025020"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">The &quot;failure&quot; is defined based on the free text failure criterion from process attributes</rdfs:comment>
        <rdfs:label xml:lang="en">fatigue failure</rdfs:label>
        <skos:definition xml:lang="en">Fatigue failure is a process which is an occurent part of a sinlge fatigue testing process. If fatigue failure took place, it means that the defined failure criterion has been satisfied.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/mech/MECH_0000052 -->

    <owl:Class rdf:about="https://w3id.org/pmd/mech/MECH_0000052">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/pmd/co/PMD_0025020"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000117"/>
                        <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/mech/MECH_0000051"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0025020"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000117"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/mech/MECH_0000051"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">For determining the S-N curve for a specific material, the query must contain outputs and/or process attributes of instances of this class!</rdfs:comment>
        <rdfs:label xml:lang="en">single fatigue testing process with failure</rdfs:label>
        <skos:definition xml:lang="en">Single fatigue testing process with failure is a process of determining number of cycles a sinlge specimen can withstand under given load. The prerequisite for this process is a failure, i.e., the fatigue failure must be an occurent part of the single fatigue testing process.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/mech/MECH_0000053 -->

    <owl:Class rdf:about="https://w3id.org/pmd/mech/MECH_0000053">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/BFO_0000030"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000087"/>
                        <owl:someValuesFrom>
                            <owl:Class>
                                <owl:intersectionOf rdf:parseType="Collection">
                                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/OBI_0000067"/>
                                    <owl:Restriction>
                                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000054"/>
                                        <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/mech/MECH_0000050"/>
                                    </owl:Restriction>
                                </owl:intersectionOf>
                            </owl:Class>
                        </owl:someValuesFrom>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000030"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000087"/>
                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:intersectionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/OBI_0000067"/>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000054"/>
                                <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/mech/MECH_0000050"/>
                            </owl:Restriction>
                        </owl:intersectionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">fatigue test run out</rdfs:label>
        <skos:definition xml:lang="en">Fatigue test run out is an object which has an evaluant role in a single fatigue testing process and does not experience failure (defined by a failure criterion) after reaching the planned number number of cycles</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/mech/MECH_0000054 -->

    <owl:Class rdf:about="https://w3id.org/pmd/mech/MECH_0000054">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0060006"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/OBI_0001938"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/OBI_0001933"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty>
                    <rdf:Description>
                        <owl:inverseOf rdf:resource="https://w3id.org/pmd/co/PMD_0001026"/>
                    </rdf:Description>
                </owl:onProperty>
                <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/mech/MECH_0000057"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>TODO which defines what?</rdfs:comment>
        <rdfs:label xml:lang="en">range of motion specification</rdfs:label>
        <skos:definition xml:lang="en">Range of motion is a device specification of  fatigue testing machine which defines ...</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/mech/MECH_0000055 -->

    <owl:Class rdf:about="https://w3id.org/pmd/mech/MECH_0000055">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000010"/>
        <rdfs:label xml:lang="en">evaluation software</rdfs:label>
        <skos:definition xml:lang="en">Software used to evaluate results of assays or computing processes</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/mech/MECH_0000056 -->

    <owl:Class rdf:about="https://w3id.org/pmd/mech/MECH_0000056">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000010"/>
        <rdfs:label xml:lang="en">fatigue test control software</rdfs:label>
        <skos:definition xml:lang="en">Software used to control the course of a fatigue testing process.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/mech/MECH_0000057 -->

    <owl:Class rdf:about="https://w3id.org/pmd/mech/MECH_0000057">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0000602"/>
        <rdfs:comment>TODO defintion</rdfs:comment>
        <rdfs:label xml:lang="en">actuator</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/mech/MECH_0000058 -->

    <owl:Class rdf:about="https://w3id.org/pmd/mech/MECH_0000058">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/mech/MECH_0000057"/>
        <rdfs:comment>TODO defintion</rdfs:comment>
        <rdfs:label xml:lang="en">piezo actuator</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/mech/MECH_0000059 -->

    <owl:Class rdf:about="https://w3id.org/pmd/mech/MECH_0000059">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/mech/MECH_0000095"/>
        <rdfs:label xml:lang="en">initial crack length</rdfs:label>
        <skos:definition xml:lang="en">Initial crack length is a length of a crack in a specimen which is an input to the crack propagation fatigue testing process.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/mech/MECH_0000060 -->

    <owl:Class rdf:about="https://w3id.org/pmd/mech/MECH_0000060">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0000502"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/OBI_0000312"/>
                <owl:allValuesFrom rdf:resource="https://w3id.org/pmd/co/PMD_0000974"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">engineering stress-strain curve</rdfs:label>
        <skos:definition xml:lang="en">Engineering stress-strain curve is a 2D data-item which is a specified output of a tensile testing process. The x-axis is a strain, i.e., the change of gauge length relative to its inital value, the y-axis is an engineering stress, i.e., force normalized to the initial cross-sectional area of a specimen.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/mech/MECH_0000061 -->

    <owl:Class rdf:about="https://w3id.org/pmd/mech/MECH_0000061">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0000502"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/OBI_0000312"/>
                <owl:allValuesFrom rdf:resource="https://w3id.org/pmd/co/PMD_0000974"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">true stress-strain curve</rdfs:label>
        <skos:definition xml:lang="en">True stress-strain curve is a 2D data-item which is a specified output of a tensile testing process. The x-axis is a strain, i.e., the change of gauge length relative to its inital value, the y-axis is a true stress, i.e., force normalized to the instantaneous cross-sectional area of a specimen.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/mech/MECH_0000062 -->

    <owl:Class rdf:about="https://w3id.org/pmd/mech/MECH_0000062">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0000502"/>
        <rdfs:label xml:lang="en">true stress-compression curve</rdfs:label>
        <skos:definition xml:lang="en">True stress-compression curve is a 2D data-item which is a specified output of a compression testing process. The x-axis is a compression, i.e., the change of gauge length relative to its inital value, the y-axis is a true stress, i.e., force normalized to the instantaneous cross-sectional area of a specimen.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/mech/MECH_0000063 -->

    <owl:Class rdf:about="https://w3id.org/pmd/mech/MECH_0000063">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/pmd/co/PMD_0000581"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://w3id.org/pmd/co/PMD_0000009"/>
                        <owl:someValuesFrom>
                            <owl:Class>
                                <owl:intersectionOf rdf:parseType="Collection">
                                    <rdf:Description rdf:about="https://w3id.org/pmd/co/PMD_0000008"/>
                                    <owl:Restriction>
                                        <owl:onProperty rdf:resource="https://w3id.org/pmd/co/PMD_0020127"/>
                                        <owl:someValuesFrom>
                                            <owl:Class>
                                                <owl:intersectionOf rdf:parseType="Collection">
                                                    <rdf:Description rdf:about="https://w3id.org/pmd/co/PMD_0000967"/>
                                                    <owl:Restriction>
                                                        <owl:onProperty rdf:resource="https://w3id.org/pmd/co/PMD_0000077"/>
                                                        <owl:someValuesFrom>
                                                            <owl:Class>
                                                                <owl:intersectionOf rdf:parseType="Collection">
                                                                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/OBI_0001931"/>
                                                                    <owl:Restriction>
                                                                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000039"/>
                                                                        <owl:hasValue rdf:resource="http://purl.obolibrary.org/obo/UO_0000027"/>
                                                                    </owl:Restriction>
                                                                    <owl:Restriction>
                                                                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/OBI_0001937"/>
                                                                        <owl:someValuesFrom>
                                                                            <rdfs:Datatype>
                                                                                <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
                                                                                <owl:withRestrictions rdf:parseType="Collection">
                                                                                    <rdf:Description>
                                                                                        <xsd:minExclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">25</xsd:minExclusive>
                                                                                    </rdf:Description>
                                                                                </owl:withRestrictions>
                                                                            </rdfs:Datatype>
                                                                        </owl:someValuesFrom>
                                                                    </owl:Restriction>
                                                                </owl:intersectionOf>
                                                            </owl:Class>
                                                        </owl:someValuesFrom>
                                                    </owl:Restriction>
                                                </owl:intersectionOf>
                                            </owl:Class>
                                        </owl:someValuesFrom>
                                    </owl:Restriction>
                                </owl:intersectionOf>
                            </owl:Class>
                        </owl:someValuesFrom>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0000581"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/pmd/co/PMD_0000009"/>
                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:intersectionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="https://w3id.org/pmd/co/PMD_0000008"/>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="https://w3id.org/pmd/co/PMD_0020127"/>
                                <owl:someValuesFrom>
                                    <owl:Class>
                                        <owl:intersectionOf rdf:parseType="Collection">
                                            <rdf:Description rdf:about="https://w3id.org/pmd/co/PMD_0000967"/>
                                            <owl:Restriction>
                                                <owl:onProperty rdf:resource="https://w3id.org/pmd/co/PMD_0000077"/>
                                                <owl:someValuesFrom>
                                                    <owl:Class>
                                                        <owl:intersectionOf rdf:parseType="Collection">
                                                            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/OBI_0001931"/>
                                                            <owl:Restriction>
                                                                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000039"/>
                                                                <owl:hasValue rdf:resource="http://purl.obolibrary.org/obo/UO_0000027"/>
                                                            </owl:Restriction>
                                                            <owl:Restriction>
                                                                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/OBI_0001937"/>
                                                                <owl:someValuesFrom>
                                                                    <rdfs:Datatype>
                                                                        <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
                                                                        <owl:withRestrictions rdf:parseType="Collection">
                                                                            <rdf:Description>
                                                                                <xsd:minExclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">25</xsd:minExclusive>
                                                                            </rdf:Description>
                                                                        </owl:withRestrictions>
                                                                    </rdfs:Datatype>
                                                                </owl:someValuesFrom>
                                                            </owl:Restriction>
                                                        </owl:intersectionOf>
                                                    </owl:Class>
                                                </owl:someValuesFrom>
                                            </owl:Restriction>
                                        </owl:intersectionOf>
                                    </owl:Class>
                                </owl:someValuesFrom>
                            </owl:Restriction>
                        </owl:intersectionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">hot compression testing process</rdfs:label>
        <skos:definition>Hot compression testing process is a compression testing process performed at elevated temperature, i.e., it has a process attribute which refers to temperature with numerical value above 25°C.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/mech/MECH_0000064 -->

    <owl:Class rdf:about="https://w3id.org/pmd/mech/MECH_0000064">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0000848"/>
        <obo:IAO_0000119>DIN 50106</obo:IAO_0000119>
        <obo:IAO_0000119>TODO add upper and lower</obo:IAO_0000119>
        <rdfs:comment xml:lang="en">Very important note:  not added directly under yield strength from TTO, because the other yield strength is implicitly TENSILE yield strength (so much on unambigious defintions in an ontology.... )</rdfs:comment>
        <rdfs:label xml:lang="en">compressive yield strength</rdfs:label>
        <skos:definition xml:lang="en">compressive stress at the elastic-plastic transition in the case of deformation with no or only minor increase in compressive stress.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/mech/MECH_0000065 -->

    <owl:Class rdf:about="https://w3id.org/pmd/mech/MECH_0000065">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0000848"/>
        <obo:IAO_0000119>DIN 50106</obo:IAO_0000119>
        <rdfs:label xml:lang="en">compressive proof strength</rdfs:label>
        <skos:definition xml:lang="en">compressive stress at a specified plastic strain</skos:definition>
        <co:symbol xml:lang="en">R_dp</co:symbol>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/mech/MECH_0000066 -->

    <owl:Class rdf:about="https://w3id.org/pmd/mech/MECH_0000066">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/mech/MECH_0000065"/>
        <rdfs:label xml:lang="en">compressive proof strength dp02</rdfs:label>
        <skos:definition xml:lang="en">stress at which the plastic compression  is equal to 0.2 percent of the extensometer gauge length.</skos:definition>
        <co:symbol xml:lang="en">R_dp0,2</co:symbol>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/mech/MECH_0000067 -->

    <owl:Class rdf:about="https://w3id.org/pmd/mech/MECH_0000067">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0000848"/>
        <obo:IAO_0000119>DIN 50106</obo:IAO_0000119>
        <rdfs:label xml:lang="en">compressive strength</rdfs:label>
        <skos:definition>compressive stress at the point when the test piece separates into two (or more) pieces</skos:definition>
        <co:symbol xml:lang="en">R_dB</co:symbol>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/mech/MECH_0000068 -->

    <owl:Class rdf:about="https://w3id.org/pmd/mech/MECH_0000068">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0000848"/>
        <rdfs:label xml:lang="en">ductility</rdfs:label>
        <skos:definition xml:lang="en">Ductlity is a mechanical property which describes the ability of a material to sustain  plastic deformation under tensile load before fracture.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/mech/MECH_0000069 -->

    <owl:Class rdf:about="https://w3id.org/pmd/mech/MECH_0000069">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0000008"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/pmd/co/PMD_0025006"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/co/PMD_0000581"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">Compression loading type is a process attribute which describes the direction of an applied load to a specimen in a compression test.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">compression loading type</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/mech/MECH_0000070 -->

    <owl:Class rdf:about="https://w3id.org/pmd/mech/MECH_0000070">
        <owl:equivalentClass>
            <owl:Class>
                <owl:oneOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/pmd/mech/MECH_0000071"/>
                    <rdf:Description rdf:about="https://w3id.org/pmd/mech/MECH_0000072"/>
                    <rdf:Description rdf:about="https://w3id.org/pmd/mech/MECH_0000073"/>
                </owl:oneOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OBI_0001930"/>
        <obo:IAO_0000115 xml:lang="en">Compression loading type value is a categical value specification which efines the exact type of compression loading type</obo:IAO_0000115>
        <rdfs:label xml:lang="en">compression loading type value</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/mech/MECH_0000074 -->

    <owl:Class rdf:about="https://w3id.org/pmd/mech/MECH_0000074">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0000848"/>
        <rdfs:label xml:lang="en">height reduction</rdfs:label>
        <skos:definition xml:lang="en">Height reduction is a mechanical property realized in a compression test. It is defined as a decrease of specimen&apos;s length before and after process in the direction of applied load.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/mech/MECH_0000075 -->

    <owl:Class rdf:about="https://w3id.org/pmd/mech/MECH_0000075">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0000848"/>
        <rdfs:label xml:lang="en">strain rate sensitivity</rdfs:label>
        <skos:definition xml:lang="en">Strain rate sensitivity is a mechanical property of a material which is evaluated in a series of tensile or compression tests. It is determined as a relation between change in stress and change in strain expressed in log scale.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/mech/MECH_0000076 -->

    <owl:Class rdf:about="https://w3id.org/pmd/mech/MECH_0000076">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0000848"/>
        <qudt:symbol>Q</qudt:symbol>
        <rdfs:label xml:lang="en">deformation activation energy</rdfs:label>
        <skos:definition>Energy required to activate plastic deformation mechanisms at high temperatures.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/mech/MECH_0000077 -->

    <owl:Class rdf:about="https://w3id.org/pmd/mech/MECH_0000077">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0000848"/>
        <rdfs:label xml:lang="en">dynamic recrystallization onset</rdfs:label>
        <skos:altLabel xml:lang="en">DRX</skos:altLabel>
        <skos:definition xml:lang="en">The strain at which new grains start forming during compression deformation due to  sufficient strain accumulation.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/mech/MECH_0000078 -->

    <owl:Class rdf:about="https://w3id.org/pmd/mech/MECH_0000078">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0000008"/>
        <rdfs:label xml:lang="en">load step cycles</rdfs:label>
        <skos:definition xml:lang="en">Load step cycles is a process attribute of  a load increasing fatigue testing which describes a constant numer of cycles a specimen undergoes in each test with a given load.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/mech/MECH_0000079 -->

    <owl:Class rdf:about="https://w3id.org/pmd/mech/MECH_0000079">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0000848"/>
        <rdfs:label xml:lang="en">energy dissipation under cyclic loading</rdfs:label>
        <skos:definition xml:lang="en">Energy dissipation under cyclic loading is a mechanical property that defines the energy lost per loading cycle due to irreversible plastic deformation. It is determined by the area inside the stress–strain hysteresis loop.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/mech/MECH_0000080 -->

    <owl:Class rdf:about="https://w3id.org/pmd/mech/MECH_0000080">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0000502"/>
        <rdfs:label xml:lang="en">stress-strain hysteresis curve</rdfs:label>
        <skos:definition xml:lang="en">Stress-strain hysteresis curve is a 2D data item, which is an output of assay featuring cycling loading.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/mech/MECH_0000081 -->

    <owl:Class rdf:about="https://w3id.org/pmd/mech/MECH_0000081">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0000502"/>
        <rdfs:label xml:lang="en">plastic strain vs number of cycles curve</rdfs:label>
        <skos:definition xml:lang="en">Plastic strain vs number of cycles curve is 2d data item  which indicates accumulation of irreversible deformation under cycling loading.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/mech/MECH_0000082 -->

    <owl:Class rdf:about="https://w3id.org/pmd/mech/MECH_0000082">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0000848"/>
        <rdfs:label xml:lang="en">fatigue damage indicator</rdfs:label>
        <skos:definition xml:lang="en">Fatigue damage indicator is a mechanical property characterizing fatigue damage in the material. It is derived from changes in plastic strain, energy dissipation, and hysteresis loop during cyclic loading.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/mech/MECH_0000083 -->

    <owl:Class rdf:about="https://w3id.org/pmd/mech/MECH_0000083">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0000952"/>
        <obo:IAO_0000119>https://sdcverifier.com/structural-engineering-101/how-to-calculate-fatigue-strength-hand-calculations/</obo:IAO_0000119>
        <qudt:symbol>σ′f</qudt:symbol>
        <rdfs:label xml:lang="en">fatigue strength coefficient</rdfs:label>
        <skos:definition xml:lang="en">The fatigue strength coefficient is a material parameter used in the Basquin equation. It helps define the stress-life curve in the high-cycle regime.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/mech/MECH_0000084 -->

    <owl:Class rdf:about="https://w3id.org/pmd/mech/MECH_0000084">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0000848"/>
        <qudt:symbol>b</qudt:symbol>
        <rdfs:label xml:lang="en">fatigue strength exponent</rdfs:label>
        <skos:definition xml:lang="en">fatigue strength exponent is s a material parameter used in the Basquin equation. It helps define the stress-life curve in the high-cycle regime.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/mech/MECH_0000085 -->

    <owl:Class rdf:about="https://w3id.org/pmd/mech/MECH_0000085">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0025020"/>
        <rdfs:label xml:lang="en">crack propagation fatigue testing process</rdfs:label>
        <skos:definition xml:lang="en">Crack propagation fatigue testing process is a type of fatigue testing in which specimen has an intial crack.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/mech/MECH_0000086 -->

    <owl:Class rdf:about="https://w3id.org/pmd/mech/MECH_0000086">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0000502"/>
        <rdfs:label xml:lang="en">crack length vs number of cycles curve</rdfs:label>
        <skos:definition xml:lang="en">Crack length vs number of cycles curve is 2D data item  which indicates the propagation of crack under cycling loading.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/mech/MECH_0000087 -->

    <owl:Class rdf:about="https://w3id.org/pmd/mech/MECH_0000087">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0025019"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/pmd/co/PMD_0025006"/>
                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:intersectionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="https://w3id.org/pmd/co/PMD_0000587"/>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000132"/>
                                <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/mech/MECH_0000085"/>
                            </owl:Restriction>
                        </owl:intersectionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <qudt:symbol>da/dN</qudt:symbol>
        <rdfs:label xml:lang="en">crack growth rate</rdfs:label>
        <skos:definition xml:lang="en">Crack growth rate is a process attribute of a crack growth, which is an occurent part of a crack propagation fatigue testing process. It is defined as an increase of crack length over a single fatigue cycle.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/mech/MECH_0000088 -->

    <owl:Class rdf:about="https://w3id.org/pmd/mech/MECH_0000088">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0000848"/>
        <qudt:symbol>C</qudt:symbol>
        <qudt:symbol xml:lang="en">scaling factor of Paris law is a mechanical property of material used in the Paris law to analytically determine the crack growth rate.</qudt:symbol>
        <rdfs:label xml:lang="en">scaling factor of Paris law</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/mech/MECH_0000089 -->

    <owl:Class rdf:about="https://w3id.org/pmd/mech/MECH_0000089">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0000848"/>
        <qudt:symbol>m</qudt:symbol>
        <rdfs:label xml:lang="en">slope of Paris law</rdfs:label>
        <skos:definition xml:lang="en">Slope of Paris law is a mechanical property of a material which characerizes material&apos;s sensitivity to crack propagation depending on stress intensity factor deltaK</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/mech/MECH_0000090 -->

    <owl:Class rdf:about="https://w3id.org/pmd/mech/MECH_0000090">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0000848"/>
        <qudt:symbol>ΔK_th</qudt:symbol>
        <rdfs:label xml:lang="en">threshold stress intensity factor</rdfs:label>
        <skos:definition xml:lang="en">Threshold stress intensity factor is a mechanical property which defines the maximum ΔK below which crack does not grow.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/mech/MECH_0000091 -->

    <owl:Class rdf:about="https://w3id.org/pmd/mech/MECH_0000091">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0000848"/>
        <qudt:symbol>ΔK</qudt:symbol>
        <rdfs:comment xml:lang="en">K depends on crack length, stress, and geometry, Higher ΔK - faster crack growth.</rdfs:comment>
        <rdfs:label xml:lang="en">stress intensity factor range</rdfs:label>
        <skos:definition xml:lang="en">Stress intensity factor is a mechanical property which characterizes the range of stress intensity during a loading cycle in a crack propagation test.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/mech/MECH_0000092 -->

    <owl:Class rdf:about="https://w3id.org/pmd/mech/MECH_0000092">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0000848"/>
        <qudt:symbol>K_IC</qudt:symbol>
        <rdfs:comment xml:lang="en">fracture toughness is a mechanical property which characterizes the critical stress intensity factor K at which unstable fracture occurs during a crack propagation fatigue testing.</rdfs:comment>
        <rdfs:label xml:lang="en">fracture toughness</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/mech/MECH_0000093 -->

    <owl:Class rdf:about="https://w3id.org/pmd/mech/MECH_0000093">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0000502"/>
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                        <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/mech/MECH_0000045"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                        <owl:allValuesFrom rdf:resource="https://w3id.org/pmd/mech/MECH_0000045"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">scatter band of a fatigue curve</rdfs:label>
        <skos:definition xml:lang="en">Scatter band of a fatigue curve is a 2D information content entity which defines the range of variation in fatigue life from multiple tests under the same conditions.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/mech/MECH_0000094 -->

    <owl:Class rdf:about="https://w3id.org/pmd/mech/MECH_0000094">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OBI_0001931"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/OBI_0001927"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/mech/MECH_0000093"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">fatigue scatter bandwidth</rdfs:label>
        <skos:definition>+-K_D</skos:definition>
        <skos:definition xml:lang="en">Fatigue scatter bandwidth is a scalar value specification which defines absolute value of maximal deviation from a fatigue curve.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/mech/MECH_0000095 -->

    <owl:Class rdf:about="https://w3id.org/pmd/mech/MECH_0000095">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0023041"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0040001"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000080"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/co/PMD_0020202"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">crack length</rdfs:label>
        <skos:definition xml:lang="en">Crack length is a length of a crack.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/mech/MECH_0000096 -->

    <owl:Class rdf:about="https://w3id.org/pmd/mech/MECH_0000096">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/pmd/tto/TTO_0000009"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0009007"/>
                        <owl:someValuesFrom>
                            <owl:Class>
                                <owl:intersectionOf rdf:parseType="Collection">
