        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000116 xml:lang="en">OWL cardinality is restricted to xsd:integer type. Avogardo number is integer but larger that the xsd:integer range. Thus &apos;has member&apos; exactly &apos;avogadro number&apos; can not be axiomatized.</obo:IAO_0000116>
        <obo:IAO_0000117>PERSON: Philipp von Hartrott</obo:IAO_0000117>
        <rdfs:label xml:lang="en">member count</rdfs:label>
        <skos:definition xml:lang="en">the number of similar objects in an object aggregate</skos:definition>
    </owl:Class>
    


