        <rdfs:label xml:lang="en">tensile strength at 1100°C and argon atmosphere</rdfs:label>
        <skos:definition xml:lang="en">Lubricant role is a role of an object in a process, where the object aims to reduce friction between at least two other participants in the process.</skos:definition>
    </owl:Class>
    


