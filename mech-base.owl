    <!-- http://qudt.org/vocab/unit/PER-MOL -->

    <owl:NamedIndividual rdf:about="http://qudt.org/vocab/unit/PER-MOL"/>
    


    <!-- https://w3id.org/pmd/co/PMD_0020217 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/pmd/co/PMD_0020217">
        <rdf:type rdf:resource="https://w3id.org/pmd/co/PMD_0020216"/>
        <rdfs:comment>Use appropriate class from crystall ontology instead</rdfs:comment>
        <rdfs:label xml:lang="en">DEPRECATED short range order</rdfs:label>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
        <skos:definition xml:lang="en">DEPRECATED periodic arrangement of structural features up to a few entities</skos:definition>
        <skos:definition xml:lang="de">DEPRECATED periodische Anordnung von Strukturmerkmalen bis hin zu wenigen Einheiten</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/pmd/co/PMD_0020218 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/pmd/co/PMD_0020218">
        <rdf:type rdf:resource="https://w3id.org/pmd/co/PMD_0020216"/>
        <rdfs:comment>Use appropriate class from crystall ontology instead</rdfs:comment>
        <rdfs:label xml:lang="en">DEPRECATED medium range order</rdfs:label>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
        <skos:definition xml:lang="en">DEPRECATED periodic arrangement of structural features of many entities</skos:definition>
        <skos:definition xml:lang="de">DEPRECATED periodische Anordnung struktureller Merkmale vieler Entitäten</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/pmd/co/PMD_0020219 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/pmd/co/PMD_0020219">
        <rdf:type rdf:resource="https://w3id.org/pmd/co/PMD_0020216"/>
        <rdfs:comment>Use appropriate class from crystall ontology instead</rdfs:comment>
        <rdfs:label xml:lang="en">DEPRECATED long range order</rdfs:label>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
        <skos:definition xml:lang="en">DEPRECATED periodic arrangement of structural features of virtually all entities</skos:definition>
        <skos:definition xml:lang="de">DEPRECATED periodische Anordnung struktureller Merkmale praktisch aller Entitäten</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/pmd/co/PMD_0020242 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/pmd/co/PMD_0020242">
        <rdf:type rdf:resource="https://w3id.org/pmd/co/PMD_0020216"/>
        <rdfs:comment>Use appropriate class from crystall ontology instead</rdfs:comment>
        <rdfs:label xml:lang="en">DEPRECATED no range order</rdfs:label>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
        <skos:definition xml:lang="de">DEPRECATED keine periodische Anordnung struktureller Merkmale von Entitäten</skos:definition>
        <skos:definition xml:lang="en">DEPRECATED no periodic arrangement of structural features of entites</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/pmd/co/PMD_0020368 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/pmd/co/PMD_0020368">
        <rdf:type rdf:resource="http://purl.obolibrary.org/obo/OBI_0001931"/>
        <obo:IAO_0000039 rdf:resource="http://qudt.org/vocab/unit/PER-MOL"/>
        <obo:OBI_0001937 rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">602214086000000000000000</obo:OBI_0001937>
        <rdfs:label xml:lang="en">avogadro number</rdfs:label>
        <skos:definition xml:lang="en">The Avogadro number</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/pmd/mech/MECH_0000001 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/pmd/mech/MECH_0000001">
        <rdfs:label xml:lang="en">axial loading</rdfs:label>
        <skos:altLabel xml:lang="en">push-pull loading</skos:altLabel>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/pmd/mech/MECH_0000002 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/pmd/mech/MECH_0000002">
        <rdfs:label xml:lang="en">tension-tension loading</rdfs:label>
        <skos:definition>Tension-tension loading is a type of axial loading. A specimen is pulled in tension and then returned to its original length.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/pmd/mech/MECH_0000003 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/pmd/mech/MECH_0000003">
        <rdfs:label xml:lang="en">tension-compression loading</rdfs:label>
        <skos:definition>Tension-compression loading is a type of axial loading. A specimen is pulled in tension and then compressed.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/pmd/mech/MECH_0000004 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/pmd/mech/MECH_0000004">
        <rdfs:label xml:lang="en">bending loading</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/pmd/mech/MECH_0000005 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/pmd/mech/MECH_0000005">
        <rdfs:label xml:lang="en">torsional loading</rdfs:label>
        <skos:altLabel xml:lang="en">twist loading</skos:altLabel>
        <skos:definition xml:lang="en">During a fatigue test with torsional loading type the specimen is twisted and experiences shear stress.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/pmd/mech/MECH_0000006 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/pmd/mech/MECH_0000006">
        <rdfs:label xml:lang="en">rotating bending loading</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/pmd/mech/MECH_0000007 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/pmd/mech/MECH_0000007">
        <rdfs:label xml:lang="en">shear loading</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/pmd/mech/MECH_0000011 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/pmd/mech/MECH_0000011">
        <rdfs:label xml:lang="en">strain-controlled</rdfs:label>
        <skos:altLabel xml:lang="en">displacement-controlled</skos:altLabel>
        <skos:definition xml:lang="en">A fatigue test is considered stain-controlled if the strain ratio of a strain that the sample exhibits is kept constant.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/pmd/mech/MECH_0000012 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/pmd/mech/MECH_0000012">
        <rdfs:label xml:lang="en">load-controlled</rdfs:label>
        <skos:altLabel xml:lang="en">force-controlled</skos:altLabel>
        <skos:altLabel xml:lang="en">stress-controlled</skos:altLabel>
        <skos:definition xml:lang="en">A fatigue test is considered load-controlled if a load/force ratio of a load exerted on a specimen is kept constant.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/pmd/mech/MECH_0000015 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/pmd/mech/MECH_0000015">
        <rdfs:label xml:lang="en">compression-compression loading</rdfs:label>
        <skos:definition xml:lang="en">Compression-compression loading is a type of axial loading. A specimen is compresed and then returned to its original length.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/pmd/mech/MECH_0000016 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/pmd/mech/MECH_0000016">
        <rdf:type rdf:resource="http://purl.obolibrary.org/obo/OBI_0001933"/>
        <rdfs:comment>TODO there is abn abbreviation AP in PMDco</rdfs:comment>
        <rdfs:label xml:lang="en">room temperature</rdfs:label>
        <skos:altLabel xml:lang="en">RT</skos:altLabel>
        <skos:definition xml:lang="en">Room temperature is a value specification, which vaguely describes the temperature usually during some process. It leaves a room for interpretation which exact temperature is meant.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/pmd/mech/MECH_0000029 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/pmd/mech/MECH_0000029">
        <rdf:type rdf:resource="https://w3id.org/pmd/mech/MECH_0000028"/>
        <rdfs:comment>TODO write defintion</rdfs:comment>
        <rdfs:label xml:lang="en">fully reversed loading</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/pmd/mech/MECH_0000071 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/pmd/mech/MECH_0000071">
        <rdfs:label>uniaxial compression loading</rdfs:label>
        <skos:definition xml:lang="en">uniaxial compression loading is a compression loading type characterized by load applied along a single axis without any confinment along two other axes.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/pmd/mech/MECH_0000072 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/pmd/mech/MECH_0000072">
        <rdfs:label xml:lang="en">plain strain compression loading</rdfs:label>
        <skos:definition xml:lang="en">plain strain compression loading is a compression loading type characterized by specimen load applied along a single axis and the the deformation occurs in-plane.</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/pmd/mech/MECH_0000073 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/pmd/mech/MECH_0000073">
        <rdfs:label xml:lang="en">axisymmetric compression loading</rdfs:label>
        <skos:definition>axisymmetric compression loading
TODO</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/pmd/mech/MECH_0002000 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/pmd/mech/MECH_0002000">
        <rdfs:label xml:lang="en">multiaxial loading</rdfs:label>
    </owl:NamedIndividual>
    


