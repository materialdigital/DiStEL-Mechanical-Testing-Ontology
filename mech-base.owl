                            </owl:Restriction>
                        </owl:intersectionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">solution</rdfs:label>
        <skos:definition xml:lang="en">A portion of matter that is homogeneous, made up of at least two entity types, one playing the role of sovlent and the others playing the role of solute</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0020230 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0020230">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/pmd/co/PMD_0020229"/>
                    <rdf:Description rdf:about="https://w3id.org/pmd/co/PMD_0020293"/>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020229"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020293"/>
        <rdfs:label xml:lang="en">solid solution</rdfs:label>
        <skos:definition xml:lang="en">a solution with solid aggregate state</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0020254 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0020254">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020265"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000117>PERSON: Philipp von Hartrott</obo:IAO_0000117>
        <rdfs:label xml:lang="en">manufacturing property</rdfs:label>
        <skos:definition>a property that is commonly associated with the domain of manufacturing</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0020258 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0020258">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000035"/>
        <rdfs:label xml:lang="en">failure</rdfs:label>
        <skos:definition xml:lang="en">a process boundary at which a function of a participant ceases to exist</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0020259 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0020259">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020265"/>
        <rdfs:label xml:lang="en">chemical property</rdfs:label>
        <skos:definition xml:lang="en">a property that is commonly associated with the domain of chemistry</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0020263 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0020263">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000015"/>
        <rdfs:label xml:lang="en">friction</rdfs:label>
        <skos:definition xml:lang="en">a process in which two material entities are in contact and relative motion to each other</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0020265 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0020265">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000020"/>
        <obo:IAO_0000116 xml:lang="en">Do not use this class directly. Use &apos;qualtiy&apos; or &apos;realizable entity&apos;</obo:IAO_0000116>
        <rdfs:label xml:lang="en">property</rdfs:label>
        <skos:definition xml:lang="en">property is a collection class for entities that are either qualites (represent a state) or realizable entities (represent a behavior)</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0020287 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0020287">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0000001"/>
        <rdfs:label xml:lang="en">portion of matter in aggregate state</rdfs:label>
        <skos:definition xml:lang="en">a portion of matter that is at the same time in a specific aggregate state</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0020288 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0020288">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020287"/>
        <rdfs:comment>Make entity member of subclass of &apos;portion of matter in aggregate state&apos;</rdfs:comment>
        <rdfs:label xml:lang="en">atom gas</rdfs:label>
        <skos:definition xml:lang="en">a portion of matter in an gaseous aggregate state where the gas entities are atoms</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0020289 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0020289">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020287"/>
        <rdfs:label xml:lang="en">gas</rdfs:label>
        <skos:definition xml:lang="en">a portion of matter in an gaseous aggregate state where the gas entities have no bonds</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0020290 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0020290">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020287"/>
        <rdfs:label xml:lang="en">liquid</rdfs:label>
        <skos:definition xml:lang="en">a portion of matter in an liquid aggregate state where the liquid&apos;s entities transmit no shear stress</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0020291 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0020291">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020287"/>
        <rdfs:label xml:lang="en">mesomorphic</rdfs:label>
        <skos:definition xml:lang="en">a portion of matter in an mesomorphic aggregate state where some entities transmit no shear stress while others do</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0020292 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0020292">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020287"/>
        <rdfs:label xml:lang="en">plasma</rdfs:label>
        <skos:definition xml:lang="en">a portion of matter in an plasma aggregate state where entities are atom nuclei and have no bonds</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0020293 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0020293">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020287"/>
        <rdfs:label xml:lang="en">solid</rdfs:label>
        <skos:definition xml:lang="en">a portion of matter in an solid aggregate state where the solid&apos;s entities transmit shear stress</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0020294 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0020294">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020287"/>
        <rdfs:label xml:lang="en">supercritical fluid</rdfs:label>
        <skos:definition xml:lang="en">a portion of matter in an supercritical fluid aggregate state</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0020295 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0020295">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020287"/>
        <rdfs:label xml:lang="en">suprafluid</rdfs:label>
        <skos:definition xml:lang="en">a portion of matter in an suprafluid aggregate state</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0020296 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0020296">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020287"/>
        <rdfs:label xml:lang="en">suprasolid</rdfs:label>
        <skos:definition xml:lang="en">a portion of matter in a suprasolid aggregate state</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0020307 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0020307">
        <owl:equivalentClass>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000052"/>
                        <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/co/PMD_0000538"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://w3id.org/pmd/co/PMD_0025999"/>
                        <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/co/PMD_0000538"/>
                    </owl:Restriction>
                </owl:unionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0023003"/>
        <rdfs:label xml:lang="en">bulk property</rdfs:label>
        <skos:definition xml:lang="en">a &apos;property by bearer&apos; that indicates that its bearer is a bulk</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0020308 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0020308">
        <owl:equivalentClass>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000052"/>
                        <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/co/PMD_0000965"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://w3id.org/pmd/co/PMD_0025999"/>
                        <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/co/PMD_0000965"/>
                    </owl:Restriction>
                </owl:unionOf>
