                            </owl:Restriction>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="https://w3id.org/pmd/co/PMD_0000009"/>
                                <owl:someValuesFrom>
                                    <owl:Class>
                                        <owl:intersectionOf rdf:parseType="Collection">
                                            <rdf:Description rdf:about="https://w3id.org/pmd/co/PMD_0000008"/>
                                            <owl:Restriction>
                                                <owl:onProperty rdf:resource="https://w3id.org/pmd/co/PMD_0020127"/>
                                                <owl:someValuesFrom>
                                                    <owl:Class>
                                                        <owl:intersectionOf rdf:parseType="Collection">
                                                            <rdf:Description rdf:about="https://w3id.org/pmd/co/PMD_0000967"/>
                                                            <owl:Restriction>
                                                                <owl:onProperty rdf:resource="https://w3id.org/pmd/co/PMD_0000077"/>
                                                                <owl:someValuesFrom>
                                                                    <owl:Class>
                                                                        <owl:intersectionOf rdf:parseType="Collection">
                                                                            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/OBI_0001931"/>
                                                                            <owl:Restriction>
                                                                                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000039"/>
                                                                                <owl:hasValue rdf:resource="http://purl.obolibrary.org/obo/UO_0000027"/>
                                                                            </owl:Restriction>
                                                                            <owl:Restriction>
                                                                                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/OBI_0001937"/>
                                                                                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1100</owl:hasValue>
                                                                            </owl:Restriction>
                                                                        </owl:intersectionOf>
                                                                    </owl:Class>
                                                                </owl:someValuesFrom>
                                                            </owl:Restriction>
                                                        </owl:intersectionOf>
                                                    </owl:Class>
                                                </owl:someValuesFrom>
                                            </owl:Restriction>
                                        </owl:intersectionOf>
                                    </owl:Class>
                                </owl:someValuesFrom>
                            </owl:Restriction>
                        </owl:intersectionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">percentage reduction of area at fracture at 1100°C and air atmosphere</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0025997 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0025997">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OBI_0001931"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/OBI_0001927"/>
                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:intersectionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="https://w3id.org/pmd/co/PMD_0020101"/>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="https://w3id.org/pmd/co/PMD_0025999"/>
                                <owl:someValuesFrom>
                                    <owl:Class>
                                        <owl:intersectionOf rdf:parseType="Collection">
                                            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/BFO_0000040"/>
                                            <owl:Restriction>
                                                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                                                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/BFO_0000040"/>
                                            </owl:Restriction>
                                        </owl:intersectionOf>
                                    </owl:Class>
                                </owl:someValuesFrom>
                            </owl:Restriction>
                        </owl:intersectionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002350"/>
                <owl:allValuesFrom rdf:resource="https://w3id.org/pmd/co/PMD_0020004"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000117>PERSON: Kamilla Zaripova</obo:IAO_0000117>
        <rdfs:label xml:lang="de">Angabe des Bruchwerts</rdfs:label>
        <rdfs:label xml:lang="en">fraction value specification</rdfs:label>
        <skos:definition xml:lang="de">Bei der Bruchwertspezifikation handelt es sich um eine Wertspezifikation, die Informationen über den quantitativen Anteil eines Teils im Verhältnis zu einem angegebenen Ganzen enthält.</skos:definition>
        <skos:definition xml:lang="en">Fraction value specification is a value specification that contains information about quantitative share of a part relative to a specified whole.</skos:definition>
        <skos:example xml:lang="en">2.05 wt.% of carbon in steel, 4 vol.% of nitric acid in a solution</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0040001 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0040001">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020132"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000116 xml:lang="en">Necessary and sufficient conditions for &apos;length&apos; have not yet been formalized. The term is defined as a specific subtype of &apos;DimensionQuality&apos;. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions. The definition is adapted from: http://purl.obolibrary.org/obo/PATO_0000122.</obo:IAO_0000116>
        <obo:IAO_0000117>PERSON: Lars Vogt</obo:IAO_0000117>
        <rdfs:comment xml:lang="en">Length is a size that describes the spatial extent of its bearer in one dimension.</rdfs:comment>
        <rdfs:label xml:lang="de">Länge</rdfs:label>
        <rdfs:label xml:lang="en">length</rdfs:label>
        <skos:altLabel xml:lang="en">dimension</skos:altLabel>
        <skos:definition xml:lang="de">Die Länge ist eine eindimensionale Größe.</skos:definition>
        <skos:definition xml:lang="en">Length is a one dimensional size.</skos:definition>
        <skos:example xml:lang="en">A steel rod measures 250 mm in length between its two end faces</skos:example>
        <co:PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</co:PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0050000 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0050000">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020353"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/pmd/co/PMD_0025999"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/CHEBI_33250"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000117>PERSON: Markus Schilling</obo:IAO_0000117>
        <rdfs:label xml:lang="de">Bindung</rdfs:label>
        <rdfs:label xml:lang="en">atomic bond</rdfs:label>
        <skos:definition xml:lang="en">A bond is a relational quality describing the force interaction between atoms.</skos:definition>
        <skos:definition xml:lang="de">Eine Bindung ist eine relationale Qualität, die die Kraftwechselwirkung zwischen Atomen beschreibt.</skos:definition>
        <co:PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</co:PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0050002 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0050002">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0050000"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000117>PERSON: Markus Schilling</obo:IAO_0000117>
        <obo:IAO_0000119 rdf:resource="https://www.thoughtco.com/metallic-bond-definition-properties-and-examples-4117948"/>
        <rdfs:label xml:lang="en">metallic bond</rdfs:label>
        <rdfs:label xml:lang="de">metallische Bindung</rdfs:label>
        <skos:definition xml:lang="en">A metallic bond is a bond that forms between metal atoms, where electrons are shared in a &quot;sea&quot; of electrons that move freely around the metal ions. This type of bonding gives metals their characteristic properties such as conductivity and malleability.</skos:definition>
        <skos:definition xml:lang="de">Eine Metallbindung ist eine Bindung, die zwischen Metallatomen entsteht, wobei Elektronen in einem „Meer“ von Elektronen geteilt werden, die sich frei um die Metallionen bewegen. Diese Art der Bindung verleiht Metallen ihre charakteristischen Eigenschaften wie Leitfähigkeit und Formbarkeit.</skos:definition>
        <co:PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</co:PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0050051 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0050051">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0040001"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000117>PERSON: Markus Schilling</obo:IAO_0000117>
        <obo:IAO_0000119>“Diameter.” Merriam-Webster.com Dictionary, Merriam-Webster, https://www.merriam-webster.com/dictionary/diameter. Accessed 5 Dec. 2022.</obo:IAO_0000119>
        <rdfs:label xml:lang="de">Durchmesser</rdfs:label>
        <rdfs:label xml:lang="en">diameter</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://w3id.org/pmd/co/2.0.8/Diameter"/>
        <skos:definition xml:lang="de">Die Länge einer geraden Linie durch den Mittelpunkt eines Objekts oder Raums.</skos:definition>
        <skos:definition xml:lang="en">The length of a straight line through the center of an object or space.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0050153 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0050153">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0040001"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000117>PERSON: Markus Schilling</obo:IAO_0000117>
        <rdfs:label xml:lang="de">Dicke</rdfs:label>
        <rdfs:label xml:lang="en">thickness</rdfs:label>
        <skos:definition xml:lang="en">A length that describes the measured dimension in one direction of a test piece.</skos:definition>
        <skos:definition xml:lang="de">Diese Klasse beschreibt das gemessene Maß in einer Richtung eines Prüfkörpers.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0050154 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0050154">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0040001"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000117>PERSON: Markus Schilling</obo:IAO_0000117>
        <rdfs:label xml:lang="de">Breite</rdfs:label>
        <rdfs:label xml:lang="en">width</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://w3id.org/pmd/co/2.0.8/Width"/>
        <rdfs:seeAlso rdf:resource="https://www.merriam-webster.com/dictionary/width"/>
        <skos:definition xml:lang="de">Diese Klasse beschreibt eine horizontale Messung eines Objekts, die im rechten Winkel zur Länge des Objekts vorgenommen wird.</skos:definition>
        <skos:definition xml:lang="en">This class describes a horizontal measurement of an object taken at right angles to the length of the object.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0050155 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0050155">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020353"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000117>PERSON: Markus Schilling</obo:IAO_0000117>
        <obo:IAO_0000119>“Shape.” Merriam-Webster.com Dictionary, Merriam-Webster, https://www.merriam-webster.com/dictionary/shape. Accessed 13 Jan. 2023.</obo:IAO_0000119>
        <rdfs:label xml:lang="de">Form</rdfs:label>
        <rdfs:label xml:lang="en">shape</rdfs:label>
        <skos:definition xml:lang="de">Das sichtbare Ausstattungsmerkmal (räumliche Form oder Kontur) eines bestimmten Objektes oder einer Art von Objekt.</skos:definition>
        <skos:definition xml:lang="en">Extemsive quality, the visible makeup characteristic (spatial form or contour) of a particular item or kind of item.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0050156 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0050156">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0050155"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000117>PERSON: Markus Schilling</obo:IAO_0000117>
        <obo:IAO_0000119>DIN EN ISO 6892-1:2019</obo:IAO_0000119>
        <rdfs:label xml:lang="de">Geometrische Form</rdfs:label>
        <rdfs:label xml:lang="en">geometry shape</rdfs:label>
        <skos:definition xml:lang="de">Dieses Konzept beschreibt die geometrischen Abmessungen und das Erscheinungsbild (Form und Abmaße) einer Probe, eines Prüfkörpers oder eines Prüfstücks, wie sie üblicherweise durch eine entsprechende Norm definiert sind. Dementsprechend ist der angegebene Formwert in Übereinstimmung mit der definierenden Norm anzugeben, z. B. &quot;Zugprüfstück Form 1 gemäß Anhang B der Zugversuchsnorm&quot;.</skos:definition>
        <skos:definition xml:lang="en">This concept describes the geometric dimensions and appearance (shape and dimensions) of a sample, specimen, or test piece as usually defined by a corresponding standard. Accordingly, the shape value given is in accordance with the defining standard, e.g., ‘tensile test piece shape 1 in accordance with annex B of the tensile test standard’.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0050157 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0050157">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0050156"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000117>PERSON: Markus Schilling</obo:IAO_0000117>
        <rdfs:label xml:lang="de">3D Geometrie</rdfs:label>
        <rdfs:label xml:lang="en">shape 3d</rdfs:label>
        <skos:definition xml:lang="en">A shape 3D is a geometry shape that exists in three dimensions, having length, width, and height, and can be defined by its spatial properties such as volume and surface area.</skos:definition>
        <skos:definition xml:lang="de">Eine 3D Geometrie ist eine geometrische Form, die in drei Dimensionen existiert, mit Länge, Breite und Höhe, und die durch ihre räumlichen Eigenschaften wie Volumen und Oberfläche definiert werden kann.</skos:definition>
        <skos:example xml:lang="de">Beispiele sind Formen wie Würfel, Kugeln und Pyramiden.</skos:example>
        <skos:example xml:lang="en">Examples include shapes like cubes, spheres, and pyramids.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0060006 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0060006">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000033"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000117>PERSON: Hossein Beygi Nasrabadi</obo:IAO_0000117>
        <rdfs:label xml:lang="en">device specification</rdfs:label>
        <skos:definition xml:lang="en">A directive information entity that outlines the technical requirements, features, constraints, and performance criteria of a specific device, guiding its design, manufacturing, operation, or maintenance.</skos:definition>
        <co:PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</co:PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0060008 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0060008"/>
    


    <!-- https://w3id.org/pmd/co/PMD_0060009 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0060009"/>
    


    <!-- https://w3id.org/pmd/co/PMD_0080019 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0080019">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020132"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000116 xml:lang="en">Necessary and sufficient conditions for &apos;area&apos; have not yet been formalized. The term is defined as a specific subtype of &apos;DimensionQuality&apos;. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions. The definition is adapted from: http://purl.obolibrary.org/obo/PATO_0001323.</obo:IAO_0000116>
        <obo:IAO_0000117>PERSON: Thomas Hanke</obo:IAO_0000117>
        <obo:IAO_0000119 rdf:resource="http://purl.obolibrary.org/obo/PATO_0001323"/>
        <rdfs:label xml:lang="de">Fläche</rdfs:label>
        <rdfs:label xml:lang="en">area</rdfs:label>
        <skos:definition xml:lang="en">Area signifies a 2-D extent quality inhering by virtue of the bearer&apos;s two-dimensional extent</skos:definition>
        <skos:definition xml:lang="de">Fläche bedeutet eine zweidimensionale Ausdehnungsqualität, die aufgrund der zweidimensionalen Ausdehnung des Trägers inhärent ist</skos:definition>
        <skos:example xml:lang="en">The cross-sectional area of a tensile specimen at the gauge section is 50 mm2</skos:example>
        <co:PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</co:PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0080022 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0080022">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000019"/>
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/pmd/co/PMD_0020312"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000080"/>
                        <owl:someValuesFrom>
                            <owl:Class>
                                <owl:unionOf rdf:parseType="Collection">
                                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/BFO_0000027"/>
                                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/BFO_0000030"/>
                                </owl:unionOf>
                            </owl:Class>
                        </owl:someValuesFrom>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <obo:IAO_0000117>PERSON: Thomas Hanke</obo:IAO_0000117>
        <rdfs:label xml:lang="en">electric charge</rdfs:label>
        <rdfs:label xml:lang="de">elektrische Ladung</rdfs:label>
        <skos:definition xml:lang="en">Electric charge refers to the physical property of matter causing it to experience a force when placed in an electromagnetic field</skos:definition>
        <skos:example xml:lang="en">A capacitor stores 10 µC of electric charge at a voltage of 5 V</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0080029 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0080029">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020311"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0023004"/>
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000052"/>
                        <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/co/PMD_0000001"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002328"/>
                        <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/co/PMD_0020132"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <obo:IAO_0000117>PERSON: Thomas Hanke</obo:IAO_0000117>
        <rdfs:label xml:lang="de">Dehnung</rdfs:label>
        <rdfs:label xml:lang="en">strain</rdfs:label>
        <skos:definition xml:lang="en">Strain is defined as relative deformation, compared to a reference position configuration</skos:definition>
        <skos:example xml:lang="en">Under a tensile load, a polymer film exhibits a strain of 2 % before yielding</skos:example>
        <co:PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</co:PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0080034 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0080034">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0080029"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000116 xml:lang="en">Necessary and sufficient conditions for &apos;elastic strain&apos; have not yet been formalized. The term is defined as a specific subtype of &apos;strain&apos;. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions. The definition is adapted from: https://en.wikipedia.org/wiki/Plasticity_(physics).</obo:IAO_0000116>
        <obo:IAO_0000117>PERSON: Thomas Hanke</obo:IAO_0000117>
        <obo:IAO_0000119 rdf:resource="https://en.wikipedia.org/wiki/Plasticity_(physics)"/>
        <rdfs:label xml:lang="en">elastic strain</rdfs:label>
        <rdfs:label xml:lang="de">elastische Deformation</rdfs:label>
        <skos:altLabel xml:lang="en">elastic deformation</skos:altLabel>
        <skos:altLabel xml:lang="de">elastische Verformung</skos:altLabel>
        <skos:definition xml:lang="de">Bei der elastischen Dehnung handelt es sich um eine Dehnungsqualität eines Materialgebildes, die durch eine reversible Verformung gekennzeichnet ist, die bei Wegnahme der aufgebrachten Last verschwindet</skos:definition>
        <skos:definition xml:lang="en">Elastic strain is a strain quality of a material entity characterized by reversible deformation that disappears upon removal of the applied load</skos:definition>
        <skos:example xml:lang="en">Steel loaded to 200 MPa exhibits an elastic strain of about 0.001, fully recovered upon unloading</skos:example>
        <co:PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</co:PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0080069 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0080069">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020353"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000116 xml:lang="en">Necessary and sufficient conditions for &apos;physical relational quality&apos; have not yet been formalized. The term is defined as a specific subtype of &apos;BFO_0000145&apos;. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions.</obo:IAO_0000116>
        <obo:IAO_0000117>PERSON: Thomas Hanke</obo:IAO_0000117>
        <rdfs:label xml:lang="en">physical relational quality</rdfs:label>
        <rdfs:label xml:lang="de">physisch relative Qualität</rdfs:label>
        <skos:definition xml:lang="de">Die physische Beziehungsqualität bezieht sich auf Eigenschaften oder Merkmale einer Entität, die von ihrer Beziehung zu anderen Entitäten abhängig sind</skos:definition>
        <skos:definition xml:lang="en">Physical relational quality pertains to properties or characteristics of an entity dependent on its relation to other entities</skos:definition>
        <skos:example xml:lang="en">The coefficient of friction between two surfaces is a physical relational quality inhering in both contacting materials</skos:example>
        <co:PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</co:PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0080100 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0080100">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020102"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000116 xml:lang="en">Necessary and sufficient conditions for &apos;mass fraction&apos; have not yet been formalized. The term is defined as a specific subtype of &apos;mass ratio&apos;. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions. The definition is adapted from: https://de.wikipedia.org/wiki/Massenanteil.</obo:IAO_0000116>
        <obo:IAO_0000117>PERSON: Thomas Hanke</obo:IAO_0000117>
        <obo:IAO_0000119 rdf:resource="https://de.wikipedia.org/wiki/Massenanteil"/>
        <rdfs:label xml:lang="de">Massenanteil</rdfs:label>
        <rdfs:label xml:lang="en">mass fraction</rdfs:label>
        <skos:definition xml:lang="de">Der Massenanteil beschreibt den relativen Anteil einer Masse an der Gesamtmasse einer Mischung, ein gängiges quantitatives Maß</skos:definition>
        <skos:definition xml:lang="en">mass ratio that describes the relative proportion of a mass to the total mass of a mixture, a common quantitative measure</skos:definition>
        <skos:example xml:lang="en">A binary Al-4 wt% Cu alloy has a copper mass fraction of 0.04</skos:example>
        <co:PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</co:PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0080108 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0080108">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020311"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0023004"/>
        <rdfs:subClassOf rdf:nodeID="genid1966"/>
        <rdfs:subClassOf rdf:nodeID="genid1972"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000052"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/co/PMD_0000001"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000117>PERSON: Thomas Hanke</obo:IAO_0000117>
        <rdfs:label xml:lang="de">Spannung</rdfs:label>
        <rdfs:label xml:lang="en">stress</rdfs:label>
        <skos:definition xml:lang="en">Stress is the internal force per unit area a material experiences under external load, commonly described in tensile, compressive, or shear forms</skos:definition>
        <skos:example xml:lang="en">A cross-section of a loaded steel column bears a compressive stress of 150 MPa</skos:example>
        <co:PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</co:PMD_0000060>
    </owl:Class>
    <owl:Class rdf:nodeID="genid1966">
        <owl:intersectionOf rdf:parseType="Collection">
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002328"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/co/PMD_0020200"/>
            </owl:Restriction>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002328"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/co/PMD_0080019"/>
            </owl:Restriction>
        </owl:intersectionOf>
    </owl:Class>
    <owl:Class rdf:nodeID="genid1972">
        <owl:intersectionOf rdf:parseType="Collection">
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002328"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/co/PMD_0020352"/>
            </owl:Restriction>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002328"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/co/PMD_0020380"/>
            </owl:Restriction>
        </owl:intersectionOf>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://w3id.org/pmd/co/PMD_0080108"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#subClassOf"/>
        <owl:annotatedTarget rdf:nodeID="genid1966"/>
        <rdfs:comment xml:lang="en">Mechanical view on stress</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://w3id.org/pmd/co/PMD_0080108"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#subClassOf"/>
        <owl:annotatedTarget rdf:nodeID="genid1972"/>
        <rdfs:comment xml:lang="en">Thermodynamic view on stress</rdfs:comment>
    </owl:Axiom>
    


    <!-- https://w3id.org/pmd/co/PMD_0080116 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0080116">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000019"/>
        <rdfs:subClassOf rdf:nodeID="genid1979"/>
        <obo:IAO_0000117>Philipp von Hartrott</obo:IAO_0000117>
        <rdfs:comment xml:lang="en">Every potential in physics is the same mathematical object — a partial derivative of energy with respect to its conjugate extensive quantity. The differences are only in which extensive quality you&apos;re considering.</rdfs:comment>
        <rdfs:label xml:lang="en">potential</rdfs:label>
        <skos:definition xml:lang="en">a partial derivative of energy with respect to its conjugate extensive quantity</skos:definition>
        <co:PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</co:PMD_0000060>
    </owl:Class>
    <owl:Class rdf:nodeID="genid1979">
        <owl:intersectionOf rdf:parseType="Collection">
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002328"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/co/PMD_0020142"/>
            </owl:Restriction>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002328"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/co/PMD_0020319"/>
            </owl:Restriction>
        </owl:intersectionOf>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://w3id.org/pmd/co/PMD_0080116"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#subClassOf"/>
        <owl:annotatedTarget rdf:nodeID="genid1979"/>
        <rdfs:comment xml:lang="en">In field theories (e.g., gravity, electrostatics), the potential becomes a field ϕ(r⃗), and the force is recovered via:
F=−∇ϕ(r⃗)F
This is the spatial analogue: instead of asking &quot;how does energy change per unit carrier added?&quot;, you ask &quot;how does energy change per unit carrier moved in space?&quot;</rdfs:comment>
    </owl:Axiom>
    


