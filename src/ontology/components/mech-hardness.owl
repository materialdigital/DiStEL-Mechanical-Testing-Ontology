     xmlns:oboInOwl="http://www.geneontology.org/formats/oboInOwl#">
    <owl:Ontology rdf:about="https://w3id.org/pmd/mech/components/mech-hardness.owl">
        <owl:imports rdf:resource="https://w3id.org/pmd/mech/components/mech-shared.owl"/>
