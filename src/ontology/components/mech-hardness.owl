    <!-- https://w3id.org/pmd/mech/MECH_0002009 -->

    <owl:Class rdf:about="https://w3id.org/pmd/mech/MECH_0002009">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020353"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000052"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/co/PMD_0000965"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <qudt:symbol xml:lang="en">Rz</qudt:symbol>
        <rdfs:label xml:lang="en">Rz</rdfs:label>
        <skos:definition xml:lang="en">Rz is a surface property of an object which is the average maximum height of a surface profile, calculated by measuring the vertical distance from the highest peak to the lowest valley within individual sampling lengths and averaging them</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/mech/MECH_0002010 -->

    <owl:Class rdf:about="https://w3id.org/pmd/mech/MECH_0002010">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000052"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/co/PMD_0000965"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <owl:disjointWith rdf:resource="https://w3id.org/pmd/mech/MECH_0002011"/>
        <rdfs:label xml:lang="en">surface hardness</rdfs:label>
        <skos:definition xml:lang="en">The surface hardness is a hardness measured on the surface of an object</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/mech/MECH_0002011 -->

    <owl:Class rdf:about="https://w3id.org/pmd/mech/MECH_0002011">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000052"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/co/PMD_0000538"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">core hardness</rdfs:label>
        <skos:definition xml:lang="en">The core hardness is a hardness measured on the bulk or core of an object</skos:definition>
    </owl:Class>
</rdf:RDF>



